function freshSeed(){return SEED.map(o=>{const c={...o};c.pri=c.status==='action'?priCalc(c):0;return c;});}
let T=[];                 // 初始空，刷新时显示骨架 loading，不假写代币
let loadingScreen=true;   // 首次拿到真实/DEMO 数据前显示骨架

/* ── 持仓 (逃生监控) ── */
/* 初始/真实模式刷新瞬间空列表；DEMO 模式用这组演示持仓（覆盖 平稳/留意/高风险/逃生 四档，
   前 3 个 address 与筛选演示数据一致 → 顶部警灯「只看持仓」可筛出 + 显示雷达；
   LATEMOON 在筛选里是 reject(非全绿)→ 卡片弱红；RUGRUN 不在筛选(掉榜)→ 也弱红） */
function seedPositions(){return [
 {sym:'CLEANCAT',address:'7Hx9pQ2mKvR3tWn4bYj6cLwZ8sFgUaXpBn5dMfTqVrJk',size:0.01,pnl:0.32,severity:8,escaping:false,_frozen:true,entryPrice:0.0021,price:0.002772,mcap:4200000,liquidity:310000,sigs:[{k:'sig_normal',hot:false}]},
 {sym:'GOODDOG',address:'4nQ1dFgUaXpBn8dMfTqVrJkH2x9pQ7mKvR3tWn6bYj5cd',size:0.01,pnl:0.06,severity:38,escaping:false,_frozen:true,entryPrice:0.0008,price:0.000848,mcap:820000,liquidity:55000,sigs:[{k:'sig_top31',hot:false}]},
 {sym:'LATEMOON',address:'2MfTqVrJkHx9pQ3mKvR7tWn4bYj6cLwZ8sFgUaXpBn5dz',size:0.01,pnl:-0.21,severity:62,escaping:false,_frozen:true,entryPrice:0.05,price:0.0395,mcap:650000,liquidity:42000,sigs:[{k:'sig_top45',hot:false},{k:'sig_5mweak',hot:false}]},
 {sym:'RUGRUN',address:'RUGRUNzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz',size:0.01,pnl:-0.61,severity:88,escaping:true,entryPrice:0.003,price:0.00117,mcap:120000,liquidity:8500,sigs:[{k:'sig_mintback',hot:true},{k:'sig_top58',hot:true}]},
];}
let POS=[];

let RISK={open:1,openMax:20,expo:0.2857,expoMax:1.0,loss:0,lossMax:0.5,consec:0,consecMax:3,killed:false};
const P=x=>Math.round(x*100)+'%';
const gst=(t,i)=>t.died===null?(i<5?'pass':'pass'):i<t.died?'pass':i===t.died?'fail':'skip';

/* ── backend normalize ── */
function deriveDied(action,reason){
  if(action==='BUY'||action==='ACTION')return null;
  const r=(reason||'').toLowerCase();
  if(/honeypot|lp|mint|security|bundler|dev|top10|安全|避雷/.test(r))return 1;
  if(/confluence|smart.?money|共识/.test(r))return 2;
  if(/suppress|rank|抑制|排序/.test(r))return 3;
  if(/llm|conviction|crowd|late|拥挤/.test(r))return 4;
  return 1;
}
function normalize(data){
  const list=(data.decisions||[]).map(d=>{
    const dec=d.decision||d, v=dec.verdict||{}, f=dec.features||{}, ex=d.exec||dec.exec||{};
    let sym=dec.symbol||'?', inj=false; if(/redact/i.test(sym)){inj=true;sym='INJECT';}
    const isAct=(dec.action==='BUY'||dec.action==='ACTION'||dec.status==='action');
    const t={sym,inj,addr:(dec.address||'').slice(0,8)+'…',
      dex:dec.dex||f.dex||(dec.address&&dec.address.endsWith('pump')?'PUMP':'RAY-CPMM'),
      hp:!!f.honeypot,ren:(f.renounced!==undefined?!!f.renounced:!!f.renounced_mint),
      bund:f.bundler||0,dev:f.dev_hold||0,top10:f.top10||0,
      smc:f.sm_confluence||0,degen:f.smart_degen||0,kol:f.renowned||0,age:f.age_min,crowd:v.crowdedness||'-',
      mcap:f.mcap||dec.mcap||0,liq:f.liquidity||dec.liquidity||0,turnover:f.turnover||dec.turnover||0,
      chg_5m:f.chg_5m||dec.chg_5m||0,chg_1h:f.chg_1h||dec.chg_1h||0,
      devScore:(f.dev_score==null?null:f.dev_score),devLaunches:(f.dev_launches==null?null:f.dev_launches),devAlive:(f.dev_alive==null?null:f.dev_alive),devRugged:(f.dev_rugged==null?null:f.dev_rugged),devRugRate:(f.dev_rug_rate==null?null:f.dev_rug_rate),devInner:(f.dev_inner_count==null?null:f.dev_inner_count),devSurv:(f.dev_survival==null?null:f.dev_survival),devSecUnsafe:(f.dev_sec_unsafe==null?null:f.dev_sec_unsafe),devSecChecked:(f.dev_sec_checked==null?null:f.dev_sec_checked),devSecRisks:(f.dev_sec_risks||[]),devAth:(f.dev_ath_mc==null?0:f.dev_ath_mc),devExited:!!f.dev_exited,devReskin:!!f.dev_reskin,
      v:v.verdict||'-',conv:v.conviction||0,status:isAct?'action':'reject',
      warn:!!dec.risk_warn,size:dec.size_sol||0,died:deriveDied(dec.action,dec.reason),
      reason:dec.reason,address:dec.address,
      exit:(ex&&ex.hard_sl)?`SL ${ex.hard_sl} · TP ${(ex.tp_ladder||[]).join(' / ')} · trailing ${ex.trailing||''}`:'',
      thesis:v.thesis||'',
      councilScore:dec.council_score!=null?dec.council_score:(isAct?80:25),
      councilRisk:dec.risk_label||(dec.council_score>=80?'LOW_RISK':dec.council_score>=60?'MODERATE_RISK':dec.council_score>=40?'ELEVATED_RISK':'HIGH_RISK'),
      councilGates:dec.council_gates_passed!=null?dec.council_gates_passed:(dec.council_score>=80?5:dec.council_score>=60?4:dec.council_score>=40?2:1),
      council:dec.council||null};
    t.pri=isAct?(dec.priority??priCalc(t)):0; return t;
  });
  const p=data.portfolio||{};
  const risk={open:p.open_positions??1,openMax:p.max_concurrent??2,expo:p.total_exposure??0,expoMax:p.max_total_exposure??1,
    loss:p.realized_loss_today??0,lossMax:p.daily_loss_cap??0.5,consec:p.consec_losses??0,consecMax:p.kill_switch_consec??3,killed:p.kill_switch??false};
  const positions=(data.positions||[]).map(q=>({sym:q.symbol||q.sym,addr:(q.address||'').slice(0,8)+'…',address:q.address,
    size:q.size_sol||q.size||0,pnl:q.pnl||0,severity:q.severity||0,escaping:(q.severity||0)>=70,
    price:q.cur_price||0,entryPrice:q.entry_price||0,
    mcap:q.mcap||0,liquidity:q.liquidity||0,
    sigs:(q.signals||[]).map(s=>typeof s==='string'?{t:s,hot:false}:s)}));
  return {list,risk,positions};
}

