# Oracle Cloud Deployment Environment Variables

# Hardcode to SHADOW for demo mode on the cloud
KIDA_MODE=SHADOW
CHAIN=sol

# Required for the UI to talk to the Backend securely
API_BEARER_TOKEN=your_secure_random_token_here

# Required for GMGN if you later switch to LIVE mode
GMGN_API_KEY=
GMGN_PRIVATE_KEY=
