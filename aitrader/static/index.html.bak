document.addEventListener('click',e=>{if(!e.target.closest('#chainPillWrap'))closeChainMenu();});

/* ── KPI ── */
let cycles=1;
function passG(g){return T.filter(t=>t.died===null||t.died>g).length;}
function killAt(g){return T.filter(t=>t.died===g).length;}
function kpiData(){
  const act=T.filter(t=>t.status==='action').length;
  // 本地后端首轮/刷新（loadingScreen）尚未拿到数据：持仓相关指标诚实显示 0，
  const hasPosData = (POS && POS.length > 0) || !loadingScreen;
  const nPos=hasPosData?POS.length:0;
  const esc=hasPosData?POS.filter(p=>p.escaping).length:0;
  const expo=hasPosData?+RISK.expo:0;
  return [
    [t('kpi_scan'),'scan','var(--lime)',cycles*T.length,t('kpi_sub_scan',cycles)],
    [t('kpi_safety'),'shield','var(--lime)',passG(1),t('kpi_sub_block',killAt(1))],
    [t('kpi_consensus'),'users','var(--lime)',passG(2),t('kpi_sub_block',killAt(2))],
    [t('kpi_pending'),'target','var(--lime)',act,t('kpi_sub_pending')],
    [t('kpi_pos'),'gauge','var(--lime)',nPos+'<small>/'+RISK.openMax+'</small>',t('kpi_sub_expo',expo.toFixed(4))],
    [t('kpi_escape'),'siren','var(--clay)',esc,esc?t('kpi_sub_escape_act'):t('kpi_sub_escape_ok')],
    [t('kpi_catch'),'target','var(--clay)','100%',t('kpi_catch_sub')],
  ];
}
function renderKpis(flash){
  document.getElementById('kpis').innerHTML=kpiData().map((d,i)=>{
    const alert=(i===5&&d[3]>0);
    return `<div class="kpi ${alert?'alert':''}" style="--ac:${d[2]}"><div class="k">${svg(d[1])}${d[0]}</div>
      <div class="v ${flash?'flash':''}">${d[3]}</div><div class="sub">${d[4]}</div></div>`;}).join('');
}

/* ── pipeline table (sorted: action by priority desc, then reject) ── */
let sel=-1;   // 默认不选中、不展开解读（笔记本屏幕省空间）；点击行展开，再点收起
let currentProtoFilter = 'ALL';

function setProtoFilter(proto){
  currentProtoFilter = proto;
  document.querySelectorAll('.pfs-pill').forEach(el => el.classList.remove('active'));
  const btn = document.getElementById('pill-' + (proto === 'PUMP.FUN' ? 'PUMP' : proto));
  if(btn) btn.classList.add('active');
  renderRows();
}

function updateProtoCounters(){
  const allT = ordered();
  const counts = { ALL: allT.length, RAYDIUM: 0, METEORA: 0, STONKFUN: 0, 'PUMP.FUN': 0, MOONSHOT: 0, LETSBONK: 0 };
  allT.forEach(t => {
    const d = (t.dex || '').toUpperCase();
    if(d.includes('RAY')) counts.RAYDIUM++;
    else if(d.includes('METEORA')) counts.METEORA++;
    else if(d.includes('STONK')) counts.STONKFUN++;
    else if(d.includes('MOON')) counts.MOONSHOT++;
    else if(d.includes('BONK')) counts.LETSBONK++;
    else if(d.includes('PUMP')) counts['PUMP.FUN']++;
    else counts.RAYDIUM++;
  });
  for(let k in counts){
    const id = 'cnt-' + (k === 'PUMP.FUN' ? 'PUMP' : k);
    const el = document.getElementById(id);
    if(el) el.textContent = counts[k];
  }
}

function ordered(){return [...T].map((t,i)=>({...t,_i:i})).sort((a,b)=>{
  if(a.status!==b.status)return a.status==='action'?-1:1;
  return b.pri-a.pri;});}

function renderRows(){
  let rows=ordered();
  updateProtoCounters();
  if(currentProtoFilter && currentProtoFilter !== 'ALL'){
    rows = rows.filter(t => {
      const d = (t.dex || '').toUpperCase();
      if(currentProtoFilter === 'RAYDIUM') return d.includes('RAY');
      if(currentProtoFilter === 'METEORA') return d.includes('METEORA');
      if(currentProtoFilter === 'STONKFUN') return d.includes('STONK');
      if(currentProtoFilter === 'PUMP.FUN' || currentProtoFilter === 'PUMP') return d.includes('PUMP');
      if(currentProtoFilter === 'MOONSHOT') return d.includes('MOON');
      if(currentProtoFilter === 'LETSBONK') return d.includes('BONK');
      return true;
    });
  }
  if(onlyHeld){const held=new Set(POS.map(p=>p.address||p.addr).filter(Boolean));rows=rows.filter(t=>held.has(t.address));}
  const box=document.getElementById('rows');
  if(!rows.length){
    if(loadingScreen){
      box.innerHTML=Array.from({length:6},()=>'<tr class="skelrow"><td colspan="13"><div class="skel-bar"></div></td></tr>').join('');
    }else{
      box.innerHTML='<tr><td colspan="13" style="padding:26px;text-align:center;color:var(--dim2)">'+(onlyHeld?t('empty_onlyheld'):t('empty_none'))+'</td></tr>';
    }
    return;
  }
  box.innerHTML=rows.map(t=>{
    const rc=t.status==='action'?(t.warn?COL.WARN:COL.ACTION):COL.SKIP;
    const gates=GATE_ICONS.map((ic,i)=>{const s=gst(t,i);const inner=s==='fail'?svg('skull'):s==='pass'?svg(ic):'';
      return `<div class="pip ${s}" data-tip="${i+1}. ${gateName(i)}　${t2('gatetip'+i)}　|　${t2('gate_self')}${t2('gst_'+s)}">${inner}</div>`;}).join('');
    let last;
    if(t.status==='action'){
      last=`<div class="qb-group">
        <button class="qb-btn" onclick="event.stopPropagation();quickBuy(${t._i},0.1)" title="Quick Buy 0.1 SOL">0.1</button>
        <button class="qb-btn" onclick="event.stopPropagation();quickBuy(${t._i},0.5)" title="Quick Buy 0.5 SOL">0.5</button>
        <button class="qb-btn" onclick="event.stopPropagation();quickBuy(${t._i},1.0)" title="Quick Buy 1.0 SOL">1.0</button>
        <button class="buybtn ${t.warn?'warn':''}" onclick="event.stopPropagation();openBuy(${t._i})">${svg('zap')}${buyAmount} ${NATIVE_UNIT[curChain]}</button>
      </div>`;
    }else{
      const diedGate=gateName(t.died);
      const rbLabel=t.died===1?t2('rb_safety'):t2('rb_cons');
      last=`<div class="qb-group"><span class="rb has-tip" style="--rc:${rc}" data-tip="${t2('rb_tip',diedGate,reasonOf(t)||t2('rb_nopass'))}">${rbLabel}</span>
      <button class="qb-btn qb-ghost" onclick="event.stopPropagation();quickBuy(${t._i},0.1)" title="Bypass: Quick Buy 0.1 SOL">0.1</button></div>`;
    }
    const priCls=t.pri>=80?'hi':t.pri>=55?'mid':'';
    const hasPos=POS.some(p=>(p.address||'')&&(p.address||'')===(t.address||''));
    const radar=hasPos?`<span class="radar" data-tip="${t2('radar_tip')}"></span>`:'';
    const chg5m=(t.chg_5m!=null&&!isNaN(t.chg_5m))?`<span class="pill-chg ${t.chg_5m>=0?'up':'dn'}">5m ${t.chg_5m>=0?'+':''}${(+t.chg_5m).toFixed(1)}%</span>`:'';
    const mcapLiqBadges=(t.mcap||t.liq||chg5m)?`<div class="tok-mcap-liq">${t.mcap?`<span class="pill-mcap">MCAP $${fmtK(t.mcap)}</span>`:''} ${t.liq?`<span class="pill-liq">LIQ $${fmtK(t.liq)}</span>`:''} ${t.turnover?`<span class="pill-to">TO ${(+t.turnover).toFixed(1)}x</span>`:''} ${chg5m}</div>`:''; 
    return `<tr data-i="${t._i}" class="${t._i===sel?'sel':''} ${t.status==='action'?'act':''}" style="--rc:${rc}">
      <td><span class="sym"><span class="tk" onclick="event.stopPropagation();copyTicker(this)" title="${t2('tk_copy_title')}">${t.sym}</span>${dexBadge(t.dex)}${radar}${t.inj?`<span class="inj" data-tip="${t2('inj_tip')}">${t2('inj_label')}</span>`:''}${caCell(t)}${mcapLiqBadges}</span></td>
      <td><div class="gates">${gates}</div></td>
      <td><span class="m ${t.hp?'bad':!t.ren?'warn':''}">${t.hp?t2('safe_honeypot'):t.ren?t2('safe_renounced'):t2('safe_not_renounced')}</span></td>
      <td><span class="m ${t.bund>.30?'bad':''}">${P(t.bund)}</span></td>
      <td><span class="m ${t.dev>.10?'bad':''}">${P(t.dev)}</span></td>
      <td><span class="m ${t.top10>.40?'bad':''}">${P(t.top10)}</span></td>
      <td><span class="m has-tip ${(Math.min(t.degen||0,t.kol||0)===0&&Math.max(t.degen||0,t.kol||0)<=2)?'dim':''}" data-tip="${t2('smc_tip',t.degen,t.kol,t.smc)}">${t.degen}/${t.kol}</span></td>
      <td>${devCell(t)}</td>
      <td><span class="m has-tip ${t.crowd==='late'?'bad':t.crowd==='crowded'?'warn':''}" data-tip="${t2('timing_label')+'　|　'+(I18N[lang]['crowdtip_'+t.crowd]?t2('crowdtip_'+t.crowd):t2('crowd_none_tip'))}">${I18N[lang]['crowd_'+t.crowd]?t2('crowd_'+t.crowd):t.crowd}</span></td>
      <td>${t.v==='-'?`<span class="has-tip" style="color:var(--dim2)" data-tip="${t2('llm_none_tip')}">—</span>`:`<span class="vd has-tip ${t.v}" data-tip="${t2('vd_tip',t.v.toUpperCase(),t2('llmtip_'+t.v)||'',(+t.conv).toFixed(2))}">${t.v.toUpperCase()}</span>`}</td>
      <td>${ratingCell(t)}</td>
      <td>${t.status==='action'?`<span class="pri ${priCls}">${t.pri}<small>${t2('pri_label')}</small></span>`:'<span style="color:var(--dim2)">—</span>'}</td>
      <td>${last}</td>
    </tr>`;}).join('');
  document.querySelectorAll('#rows tr').forEach(r=>r.onclick=()=>{const i=+r.dataset.i;sel=(sel===i?-1:i);renderRows();renderDetail();});
}
/* renderRows 内部把行对象命名为 t（沿用旧代码），与取词函数 t() 撞名，故行内取词改用别名 t2 = 全局 t */
const t2=(k,...a)=>I18N[lang]&&typeof (I18N[lang][k])==='function'?I18N[lang][k](...a):(I18N[lang]&&I18N[lang][k]!==undefined?I18N[lang][k]:t(k,...a));
function renderDetail(){
  const r=(sel>=0?T[sel]:null); if(!r){document.getElementById('detail').innerHTML='';return;}
  let right;
  if(r.status==='action'){
    const warnNote=r.warn?`<div class="lab" style="color:var(--amber);letter-spacing:0;margin-bottom:5px">${t('detail_riskwarn')}</div>`:'';
    right=`${warnNote}<span class="lime">${thesisOf(r)}</span><div style="margin-top:6px;color:var(--dim);font-size:10.5px">${t('detail_exit',exitOf(r))}</div>`;
  }else{
    right=`<div class="lab">${t('detail_died_lab',gateName(r.died))}</div><span class="clay">${reasonOf(r)}</span>`;
  }
  const action=r.status==='action'
    ? `<div class="qb-group">
        <button class="qb-btn" onclick="quickBuy(${sel},0.1)">0.1 SOL</button>
        <button class="qb-btn" onclick="quickBuy(${sel},0.5)">0.5 SOL</button>
        <button class="qb-btn" onclick="quickBuy(${sel},1.0)">1.0 SOL</button>
        <button class="buybtn ${r.warn?'warn':''}" onclick="openBuy(${sel})">${svg('zap')}${t('amt_lbl')} ${buyAmount} ${NATIVE_UNIT[curChain]}</button>
      </div>`
    : `<div class="qb-group"><span class="rb" style="--rc:${COL.SKIP}">${t('detail_filtered')}</span>
        <button class="qb-btn qb-ghost" onclick="quickBuy(${sel},0.1)">Snipe 0.1 SOL</button></div>`;
  const llmState=(r.v==='-'?t('detail_no_llm'):r.v.toUpperCase()+' · conv '+(+r.conv).toFixed(2));
  const backingRatio=(r.mcap&&r.liq)?(r.liq/r.mcap*100).toFixed(1)+'%':'—';
  const vol24est=r.mcap&&r.turnover?(r.mcap*(r.turnover/24/100)).toFixed(0):'0';
  const valCitadel=(r.mcap||r.liq)?`<div class="val-citadel">
    <div class="vc-stat"><span class="vc-k">MARKET CAP</span><span class="vc-v lime">$${fmtK(r.mcap||0)}</span></div>
    <div class="vc-stat"><span class="vc-k">POOL LIQ</span><span class="vc-v teal">$${fmtK(r.liq||0)}</span></div>
    <div class="vc-stat"><span class="vc-k">BACKING RATIO</span><span class="vc-v">${backingRatio}</span></div>
    <div class="vc-stat"><span class="vc-k">TURNOVER</span><span class="vc-v amber">${r.turnover?(+r.turnover).toFixed(1)+'x':'—'}</span></div>
    <div class="vc-stat"><span class="vc-k">5M CHANGE</span><span class="vc-v ${(r.chg_5m||0)>=0?'lime':''}" style="${(r.chg_5m||0)<0?'color:var(--clay)':''}">${r.chg_5m!=null?(r.chg_5m>=0?'+':'')+r.chg_5m.toFixed(2)+'%':'—'}</span></div>
    <div class="vc-stat"><span class="vc-k">1H CHANGE</span><span class="vc-v ${(r.chg_1h||0)>=0?'lime':''}" style="${(r.chg_1h||0)<0?'color:var(--clay)':''}">${r.chg_1h!=null?(r.chg_1h>=0?'+':'')+r.chg_1h.toFixed(2)+'%':'—'}</span></div>
    <div class="vc-stat"><span class="vc-k">COUNCIL SCORE</span><span class="vc-v lime">${r.councilScore??'—'} / 100</span></div>
    <div class="vc-stat"><span class="vc-k">DEX POOL</span><span class="vc-v">${dexBadge(r.dex)}</span></div>
  </div>`:'';
  document.getElementById('detail').innerHTML=`
    <div class="dl"><h4>${r.sym}</h4>${valCitadel}<br>${action}</div>
    <div class="dr">${devCard(r)}${councilCard(r)}${right}<div style="margin-top:8px;color:var(--dim);font-size:10.5px">${t('detail_llm_note',llmState)}</div></div>`;
}

/* ── escape monitor ── */
/* ── Live KOL Signals Fetcher & Direct Execution ── */
async function loadKolSignals(){
  try {
    const res = await fetch(API + '/api/signals/kol');
    if(!res.ok) return;
    const data = await res.json();
    const signals = data.signals || [];
    const container = document.getElementById('kolCardsFeed');
    const counter = document.getElementById('kolCounter');
    if(counter) counter.textContent = signals.length + ' CHANNELS TRACKED';
    if(!container) return;
    if(!signals.length){
      container.innerHTML = '<div class="kol-card" style="color:var(--dim2);font-family:var(--mono);font-size:11px">NO ACTIVE SIGNALS</div>';
      return;
    }
    container.innerHTML = signals.map(s => `
      <div class="kol-card">
        <div class="kol-c-header">
          <span class="kol-c-name">${esc(s.channel)}</span>
          <span class="kol-wr-badge">${Math.round(s.win_rate * 100)}% WR</span>
        </div>
        <div class="kol-c-tok">
          <span class="kol-tok-sym">$${esc(s.symbol)} <span style="font-size:9px;color:rgba(255,255,255,0.4)">${esc(s.dex)}</span></span>
          <span class="kol-tok-gain">+${(+s.gain_pct).toFixed(1)}%</span>
        </div>
        <div class="kol-c-metrics">
          <div class="kol-m-item"><span class="kol-m-lbl">MCAP</span><span class="kol-m-val">$${fmtK(s.mcap)}</span></div>
          <div class="kol-m-item"><span class="kol-m-lbl">LIQ</span><span class="kol-m-val">$${fmtK(s.liquidity)}</span></div>
          <div class="kol-m-item"><span class="kol-m-lbl">DEV</span><span class="kol-m-val" style="color:${s.dev_status==='DEV_SOLD'?'#4ade80':'#fbbf24'}">${esc(s.dev_status)}</span></div>
        </div>
        <div class="kol-c-action">
          <button class="kol-buy-btn" onclick="directBuyAddress('${s.address}', 0.1, '${esc(s.symbol)}')">BUY 0.1 SOL</button>
          <button class="kol-buy-btn" style="background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.15)" onclick="copyToClipboard('${s.address}')">COPY CA</button>
        </div>
      </div>
    `).join('');
  } catch(e) {
    console.error('Failed to load KOL signals:', e);
  }
}

async function directBuyAddress(addr, size, sym){
  if(!confirm('Execute 1-Click Buy for ' + sym + ' (' + size + ' SOL)?')) return;
  try {
    const res = await fetch(API + '/api/buy', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ chain: curChain, address: addr, size_sol: size })
    });
    const d = await res.json();
    if(res.ok && d.ok){
      toast('FILLED: ' + sym + ' (' + size + ' SOL)', 'ok');
      pollPositions();
    } else {
      toast('BUY REJECTED: ' + (d.message || d.detail || 'Error'), 'err');
    }
  } catch(err) {
    toast('EXECUTION ERROR: ' + err.message, 'err');
  }
}

function sevLevel(s){return s>=70?t('sev_escape'):s>=50?t('sev_high'):s>=30?t('sev_watch'):t('sev_stable');}
function renderPositions(){
  const box=document.getElementById('positions');
  if(loadingScreen && (!POS || !POS.length)){                       // 本地后端首轮/刷新且尚无持仓时走骨架
    document.getElementById('escCnt').textContent='';
    box.innerHTML=Array.from({length:3},()=>
      '<div class="pos"><div class="top"><div class="skel-bar" style="width:64px"></div>'
      +'<div class="skel-bar" style="width:46px;margin-left:auto"></div></div>'
      +'<div class="skel-bar" style="height:7px"></div>'
      +'<div class="skel-bar" style="width:80%;height:11px"></div></div>').join('');
    return;
  }
  const alerts=POS.filter(p=>p.escaping).length;
  document.getElementById('escCnt').textContent=POS.length?t('esc_cnt',POS.length,RISK.openMax,alerts):'';
  if(!POS.length){box.innerHTML=`<div class="posempty">${t('pos_empty')}</div>`;return;}
  box.innerHTML=POS.map((p,i)=>{
    const hot=p.severity>=70;
    // 左侧筛选判定为非全绿/掉榜 → 弱红底；首次进入该状态才闪一下
    const key=p.address||p.addr||p.sym;
    let acls=p.escaping?'esc':'';
    if(posIsAlert(p)){acls+=' falert';if(!escAlertSet.has(key)){acls+=' flash';escAlertSet.add(key);}}
    else escAlertSet.delete(key);
    const mcapBadge = p.mcap ? `<span class="pill" style="font-size:9px;padding:1px 6px;background:rgba(255,255,255,0.06);color:#cbd5e1">MCAP $${fmtK(p.mcap)}</span>` : '';
    const liqBadge = p.liquidity ? `<span class="pill" style="font-size:9px;padding:1px 6px;background:rgba(200,242,74,0.1);color:var(--lime);border-color:rgba(200,242,74,0.25)">LIQ $${fmtK(p.liquidity)}</span>` : '';
    return `<div class="pos ${acls}">
      <div class="top"><div><span class="ps">${p.sym}</span>${caCell(p)}${p.price?`<small class="px">${t('pos_price',fmtPrice(p.price),fmtPrice(p.entryPrice))}</small>`:''}
        <div style="display:flex;align-items:center;gap:5px;margin-top:4px">${mcapBadge}${liqBadge}</div>
      </div>
        <span class="pnl ${p.pnl>=0?'up':'dn'}">${p.pnl>=0?'+':''}${(p.pnl*100).toFixed(1)}%</span>
        <button class="escbtn" onclick="escape_(${i})">${svg('door')}${p.escaping?t('escbtn_now'):t('escbtn')}</button>
        <button class="xbtn" title="${t('unmon_btn_title')}" onclick="unmonitor_(${i})">×</button></div>
      <div class="sev"><div class="b"><i class="${hot?'hot':''}" style="width:${p.severity}%"></i></div><span class="lv" style="${hot?'color:var(--clay)':''}">${sevLevel(p.severity)} ${p.severity}</span></div>
      <div class="sigs">${p.sigs.map(s=>`<div class="sig ${s.hot?'hot':''}">${svg(s.hot?'warn':'shield')}${sigText(s)}</div>`).join('')}</div>
    </div>`;}).join('');
}

/* ── funnel + risk mini ── */
function renderFunnel(){
  const N=T.length, act=T.filter(t=>t.status==='action').length;
  const F=[[gateName(0),'scan',N,0,false],[gateName(1),'shield',passG(1),killAt(1),false],[gateName(2),'users',passG(2),killAt(2),false],
    [gateName(3),'filter',passG(3),killAt(3),true],[gateName(4),'brain',passG(4),killAt(4),false],[gateName(5),'target',act,0,false]];
  const max=N||1;
  document.getElementById('funnel').innerHTML=F.map(f=>`
    <div class="fn"><span class="lab">${svg(f[1])}${f[0]}</span>
      <div class="track"><i class="${f[4]?'ml':''}" data-w="${f[2]/max*100}"></i>${f[3]?`<span class="kil">−${f[3]}</span>`:''}</div>
      <span class="n">${f[2]}</span></div>`).join('');
  document.getElementById('funnelSub').textContent=t('funnel_sub',N,act);
  const bars=[[t('risk_open'),POS.length,RISK.openMax,''],[t('risk_expo'),+(+RISK.expo).toFixed(3),RISK.expoMax,' SOL'],[t('risk_loss'),RISK.loss,RISK.lossMax,' SOL'],[t('risk_streak'),RISK.consec,RISK.consecMax,'']];
  document.getElementById('riskmini').innerHTML=bars.map(b=>{const r=b[2]?b[1]/b[2]:0,hot=r>=1;
    return `<div class="rkrow"><div class="h"><span>${b[0]}</span><b class="${hot?'hot':''}">${b[1]}${b[3]} / ${b[2]}${b[3]}</b></div>
    <div class="t"><i class="${hot?'hot':''}" data-w="${Math.min(r,1)*100}"></i></div></div>`;}).join('');
  requestAnimationFrame(()=>setTimeout(()=>{
    document.querySelectorAll('#funnel .track i').forEach(i=>i.style.width=i.dataset.w+'%');
    document.querySelectorAll('#riskmini .t i').forEach(i=>i.style.width=i.dataset.w+'%');},90));
  // 顶部 KILL 指示 pill 已移除（kill-switch 风控逻辑仍在后端 + 右下风控迷你条显示）
}

function renderAll(flash){renderKpis(flash);renderRows();renderDetail();renderPositions();renderFunnel();}

/* ── log ── */
const feed=document.getElementById('logfeed');
function logRow(a,sym,reason,color){
  const ts=new Date().toISOString().substr(11,8);
  const row=document.createElement('div');row.className='lg';
  row.innerHTML=`<span class="ts">${ts}</span><span class="a" style="color:${color}">${a}</span><span class="s">${sym}</span><span class="r">${reason}</span>`;
  feed.insertBefore(row,feed.firstChild);
  while(feed.children.length>60)feed.removeChild(feed.lastChild);
}
function logScreen(){
  T.forEach(t=>{
    if(t.status==='action')logRow('SCREEN',t.sym,window.t('log_screen_reason',t.size,t.pri),COL.ACTION);
    else logRow('FILTER',t.sym,reasonOf(t),COL.SKIP);
  });
}

/* ── clock / telemetry ── */
function tick(){document.getElementById('clock').textContent=new Date().toISOString().substr(11,8)+'Z';}
function telemetry(){if(source==='demo')document.getElementById('lat').textContent=(150+Math.round(Math.random()*90))+'ms';}

/* ── position risk drift (demo escape showcase) ── */
function driftPositions(){
  POS.forEach(p=>{
    if(p.escaping||p._frozen)return;
    p.severity=Math.min(86,p.severity+8+Math.random()*6);
    p.pnl=+(p.pnl-0.02-Math.random()*0.03).toFixed(3);
    const s=p.severity;
    p.sigs=[];
    if(s>=30)p.sigs.push({k:'sig_top10sell',hot:false});
    if(s>=50)p.sigs.push({k:'sig_devout',hot:false});
    if(s>=70){p.sigs.push({k:'sig_lppull',hot:true});p.escaping=true;
      logRow('ALERT',p.sym,t('alert_lp'),COL.SKIP);}
    if(!p.sigs.length)p.sigs.push({k:'sig_normal',hot:false});
  });
}

/* ── fast positions polling ── */
let posInFlight=false;
async function pollPositions(){
  if(source!=='backend'||posInFlight||document.hidden)return;
  posInFlight=true;
  try{
    const r=await fetch(API+'/api/positions?chain='+encodeURIComponent(curChain));
    if(!r.ok)return;
    const d=await r.json();
    if(source!=='backend'||!Array.isArray(d.positions))return;
    POS=d.positions.map(q=>({
      sym:q.symbol||q.sym,
      addr:(q.address||'').slice(0,8)+'…',
      address:q.address,
      size:q.size_sol||q.size||0,
      pnl:q.pnl||0,
      severity:q.severity||0,
      escaping:(q.severity||0)>=70,
      price:q.cur_price||0,
      entryPrice:q.entry_price||0,
      mcap:q.mcap||0,
      liquidity:q.liquidity||0,
      sigs:(q.signals||[]).map(s=>typeof s==='string'?{t:s,hot:false}:s)
    }));
    renderPositions();
    renderKpis(false);
  }catch(e){
    // Transient failure, continue next cycle
  }finally{
    posInFlight=false;
  }
}

/* ── scan cycle ── */
let scanInFlight=false;
let scanFailCount=0;
async function scanCycle(){
  const sc=document.getElementById('scanning');
  if(source==='backend'){
    if(!bePolling||scanInFlight)return;       // 防重入：上一次没回来就跳过本轮，避免请求堆积雪崩
    if(document.hidden)return;                 // 后台 tab 暂停轮询，不烧配额（重新可见时立即补一轮）
    scanInFlight=true;
    sc.classList.add('on');const t0=performance.now();
    try{
      const reqChain=curChain;                   // 记下本次请求的链，返回后比对，切走了就丢弃
      const r=await fetch(API+'/api/run',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({chain:reqChain})});
      if(!r.ok)throw new Error('HTTP '+r.status);
      const data=await r.json();
      if(source!=='backend'||reqChain!==curChain)return;   // 期间切走源/切了链 → 丢弃，不拿旧链数据覆盖
      syncBackendMode(data.mode);            // 后端真实 mode 同步到开关（重启后端会回 SHADOW，避免开关停留 LIVE 误导）
      const {list,risk,positions}=normalize(data);
      loadingScreen=false;                 // 拿到后端响应，结束骨架
      scanFailCount=0;
      T=list; RISK=risk; if(positions&&positions.length)POS=positions; if(sel>=T.length)sel=-1;
      document.getElementById('lat').textContent=Math.round(performance.now()-t0)+'ms';
      cycles++;renderAll(true);logScreen();
    }catch(e){
      scanFailCount++;
      console.warn('Backend scan cycle attempt '+scanFailCount+' failed:', e.message);
      if(scanFailCount===1||scanFailCount%5===0){
        toast(t('toast_be_fail',e.message),'err');
      }
      if(loadingScreen&&scanFailCount>=3){
        loadingScreen=false;
        renderAll(false);
      }
    }
    finally{scanInFlight=false;sc.classList.remove('on');}
    return;
  }
  // demo
  sc.classList.add('on');
  const rows=[...document.querySelectorAll('#rows tr')];
  rows.forEach((r,i)=>setTimeout(()=>{r.classList.add('ping');setTimeout(()=>r.classList.remove('ping'),700);},i*90));
  setTimeout(()=>{cycles++;driftPositions();renderAll(true);telemetry();sc.classList.remove('on');},rows.length*90+250);
}

/* ── source toggle ── */
function setSource(s){
  source=s;bePolling=false;
  document.getElementById('srcDemo').classList.toggle('on',s==='demo');
  document.getElementById('srcBe').classList.toggle('on',s==='backend');
  document.getElementById('demoBar').classList.toggle('on',s==='demo');  // 演示横幅仅 DEMO 显示
  const mcp=document.getElementById('mcpPill');
  if(s==='backend'){mcp.textContent='LIVE';mcp.style.color='var(--lime)';
    bePolling=true;pollPositions();scanCycle();
    resetWalletView();   // 切回真实后端：清掉 DEMO 假数据，避免误认成真实查询结果
  }
  else{mcp.textContent='DEMO';mcp.style.color='var(--amber)';loadingScreen=false;T=freshSeed();POS=seedPositions();RISK={open:1,openMax:20,expo:0.2857,expoMax:1.0,loss:0,lossMax:0.5,consec:0,consecMax:3,killed:false};sel=-1;cycles=1;renderAll(false);feed.innerHTML='';logScreen();
    showWalletDemo();   // 切到 DEMO：钱包评估也给一份假地址+假结果，只演示布局
  }
}

/* ── config modal ── */
function openCfg(){document.getElementById('cfgScrim').classList.add('on');}
function closeCfg(){document.getElementById('cfgScrim').classList.remove('on');}
document.getElementById('gearBtn').onclick=openCfg;
/* 仅当“按下”和“松开”都在遮罩本身时才关闭——避免在输入框里拖拽复制、松手落在遮罩上误关 */
function dismissOnBackdrop(id,fn){
  const el=document.getElementById(id);let downSelf=false;
  el.addEventListener('mousedown',e=>{downSelf=(e.target===el);});
  el.addEventListener('click',e=>{if(e.target===el&&downSelf)fn();downSelf=false;});
}
dismissOnBackdrop('cfgScrim',closeCfg);

/* ── 筛选设置弹窗（热榜命令 + 轮询间隔）── */
async function openPipe(){
  document.getElementById('pollSec').value=+(pollMs/1000).toFixed(1);
  const cmdEl=document.getElementById('trendCmd');
  cmdEl.value=t('pipe_loading');document.getElementById('pipeState').textContent='';
  try{
    const r=await fetch(API+'/api/settings?chain='+encodeURIComponent(curChain));
    const d=await r.json();
    defaultTrendCmd=d.default_trending_cmd||'';
    cmdEl.value=d.trending_cmd||defaultTrendCmd;
  }catch(e){cmdEl.value='';document.getElementById('pipeState').textContent=t('pipe_be_off');}
  document.getElementById('pipeScrim').classList.add('on');
}
function closePipe(){document.getElementById('pipeScrim').classList.remove('on');}
function resetPipeCmd(){if(defaultTrendCmd)document.getElementById('trendCmd').value=defaultTrendCmd;}
// 右上角「重置」：调服务端把本链热榜命令删回默认（持久），成功后顶部提示 + 刷新编辑框
async function resetSettings(){
  if(source!=='backend'){if(defaultTrendCmd)document.getElementById('trendCmd').value=defaultTrendCmd;toast(t('toast_reset_done'),'ok');return;}
  try{
    const r=await fetch(API+'/api/settings/reset',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({chain:curChain})});
    if(!r.ok)throw new Error(await errDetail(r));
    const d=await r.json();
    document.getElementById('trendCmd').value=d.trending_cmd||defaultTrendCmd;
    toast(t('toast_reset_done'),'ok');
    if(bePolling)scanCycle();
  }catch(e){toast(t('toast_reset_fail',e.message),'err');}
}
dismissOnBackdrop('pipeScrim',closePipe);

/* ── 通用二次确认弹窗（替代浏览器 confirm）── */
let _confirmCb=null;
function confirmDialog(title,msg,cb){
  document.getElementById('confirmTitle').textContent=title;
  document.getElementById('confirmMsg').innerHTML=msg;
  _confirmCb=cb;
  document.getElementById('confirmScrim').classList.add('on');
}
function closeConfirm(){document.getElementById('confirmScrim').classList.remove('on');_confirmCb=null;}
document.getElementById('confirmOk').onclick=()=>{const cb=_confirmCb;closeConfirm();if(cb)cb();};
dismissOnBackdrop('confirmScrim',closeConfirm);
function applyPollInterval(sec){
  pollMs=Math.max(1000,Math.round(sec*1000));
  if(pollTimer)clearInterval(pollTimer);
  pollTimer=setInterval(scanCycle,pollMs);
}
async function savePipe(){
  const ss=document.getElementById('pipeState');
  const sec=parseFloat(document.getElementById('pollSec').value);
  if(!sec||sec<1){toast(t('toast_poll_min'),'err');return;}
  const cmd=document.getElementById('trendCmd').value.trim();
  ss.innerHTML='<span class="spin"></span>'+t('saving');
  try{
    const r=await fetch(API+'/api/settings',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({trending_cmd:cmd,chain:curChain})});
    if(!r.ok){const j=await r.json().catch(()=>({}));throw new Error(j.detail||('HTTP '+r.status));}
    applyPollInterval(sec);
    ss.textContent=t('pipe_applied',pollMs/1000);
    toast(t('toast_pipe_saved'),'ok');
    if(source==='backend'&&bePolling)scanCycle();
  }catch(e){ss.textContent='';toast(t('toast_pipe_fail',e.message),'err');}
}
// 后端真实 mode → 同步前端 LIVE/SHADOW 开关。后端重启会回 SHADOW；若开关停在 LIVE，
// 此处翻回 SHADOW 并弹一次警示，杜绝「以为 LIVE、实际 SHADOW 只记录」的误买。
function syncBackendMode(m){
  if(typeof m!=='string')return;
  const beLive=(m==='LIVE');
  if(beLive===liveMode)return;
  const wasLive=liveMode;
  liveMode=beLive;
  applyLiveLabel();
  if(wasLive&&!beLive)toast(t('toast_mode_reverted'),'err');   // LIVE→SHADOW 自动回落，提醒用户
}
function applyLiveLabel(){
  const ll=document.getElementById('liveLbl'); if(ll)ll.textContent=liveMode?t('live_lbl_live'):t('live_lbl_shadow');
  const v=document.getElementById('modePill');v.textContent=liveMode?t('mode_live'):t('mode_shadow');v.style.color=liveMode?'var(--clay)':'var(--amber)';
  const dot=document.getElementById('modeDot'); if(dot)dot.style.background=liveMode?'var(--clay)':'var(--amber)';
}
// 右上角 MODE 图标点击切换：→LIVE 需二次确认(动真钱)，→SHADOW 直接切。均通知后端 /api/mode。
function toggleMode(){
  const goLive=!liveMode;
  if(goLive&&tradingLocked){toast(t('toast_trade_locked'),'err');return;}   // 硬锁时不让切 LIVE
  if(source!=='backend'){                       // DEMO 无后端：仅本地翻转
    if(goLive){confirmDialog(t('confirm_live_title'),t('confirm_live_msg'),()=>{liveMode=true;applyLiveLabel();});}
    else{liveMode=false;applyLiveLabel();}
    return;
  }
  const apply=async(target)=>{
    try{
      const r=await fetch(API+'/api/mode',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({mode:target?'LIVE':'SHADOW'})});
      if(!r.ok)throw new Error(await errDetail(r));
      const d=await r.json();
      liveMode=(d.mode==='LIVE');applyLiveLabel();
      toast(liveMode?t('toast_mode_live'):t('toast_mode_shadow'),liveMode?'err':'ok');
    }catch(e){toast(t('toast_mode_fail',e.message),'err');}
  };
  if(goLive)confirmDialog(t('confirm_live_title'),t('confirm_live_msg'),()=>apply(true));
  else apply(false);
}
const val=id=>document.getElementById(id).value.trim();
// 从后端错误响应取 FastAPI 的 detail（如「链上买入失败：缺签名密钥」），取不到才回 HTTP 码
async function errDetail(resp){const j=await resp.json().catch(()=>({}));return j.detail||('HTTP '+resp.status);}
async function saveCfg(){
  const body={api_key:val('apiKey'),signing_key:val('signKey'),chain:curChain,mode:liveMode?'LIVE':'SHADOW'};
  if(!body.api_key&&!beReady){toast(t('toast_need_key'),'err');return;}  // 后端已有环境 key 则可留空
  const ss=document.getElementById('saveState');ss.innerHTML='<span class="spin"></span>'+t('saving');
  try{
    const r=await fetch(API+'/api/config',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});
    if(!r.ok)throw new Error('HTTP '+r.status);
    ss.textContent=t('cfg_saved');
    beReady=true;
    if(source==='backend'){bePolling=true;scanCycle();}
  }catch(e){ss.textContent='';toast(t('toast_cfg_fail',e.message),'err');}
}

/* ── buy modal ── */
let buyIdx=-1;
function openBuy(i){
  buyIdx=i;const r=T[i];
  document.getElementById('buySym').textContent=r.sym;
  document.getElementById('buySize').value=buyAmount;
  document.getElementById('buyExit').innerHTML=t('buy_exit_html',exitOf(r),thesisOf(r));
  const rw=document.getElementById('buyRiskWarn');
  if(r.warn){rw.style.display='block';rw.className='mwarn danger';rw.textContent=t('buy_riskwarn');}
  else rw.style.display='none';
  const mn=document.getElementById('buyModeNote');
  mn.className='mwarn'+(liveMode?' danger':'');
  mn.textContent=liveMode?t('buy_mode_live'):t('buy_mode_shadow');
  document.getElementById('buyState').textContent='';
  document.getElementById('buyScrim').classList.add('on');
}
function closeBuy(){document.getElementById('buyScrim').classList.remove('on');}
dismissOnBackdrop('buyScrim',closeBuy);
async function doBuy(){
  const r=T[buyIdx];const size=parseFloat(document.getElementById('buySize').value)||r.size;
  if(source==='backend'){
    const bs=document.getElementById('buyState');bs.innerHTML='<span class="spin"></span>'+t('buy_ordering');
    try{
      const resp=await fetch(API+'/api/buy',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({address:r.address||r.addr,size_sol:size,chain:curChain})});
      if(!resp.ok)throw new Error(await errDetail(resp));   // 带后端原因(如缺签名密钥/风控硬拦)
      const j=await resp.json();
      // 文案严格按后端返回：SHADOW=只记录；LIVE 已成交=filled；LIVE 待确认=pending（都不谎报）
      const sym=j.symbol||r.sym, st=String(j.status||'');
      const kind=st.includes('SHADOW')?'sh':(j.filled?'live':'pending');
      toast(t('toast_buy_v2',kind,sym,size,st),kind==='pending'?'err':'ok');
      closeBuy();scanCycle();
    }catch(e){bs.textContent='';toast(t('toast_buy_fail',e.message),'err');}
    return;
  }
  // demo: 加进持仓 + 更新风控 + 日志
  POS.push({sym:r.sym,addr:r.addr,address:r.address,size,pnl:0,severity:18,escaping:false,sigs:[{k:'sig_normal',hot:false}]});
  RISK.open=POS.length;RISK.expo=+(RISK.expo+size).toFixed(4);
  T[buyIdx].status='bought';
  logRow('BUY',r.sym,t('buy_log_reason',liveMode,size,exitOf(r)),COL.ACTION);
  toast(t('toast_buy_demo',liveMode,r.sym,size),'ok');
  closeBuy();renderAll(true);
}

/* ── GMGN 1-click execution preset handler ── */
async function quickBuy(i, size){
  const r=T[i];
  if(!r)return;
  const sz = parseFloat(size) || 0.1;
  toast('Quick Buying ' + sz + ' SOL of ' + r.sym + '...', 'ok');
  if(source==='backend'){
    try{
      const resp=await fetch(API+'/api/buy',{
        method:'POST',
        headers:{'Content-Type':'application/json'},
        body:JSON.stringify({address:r.address||r.addr,size_sol:sz,chain:curChain})
      });
      if(!resp.ok)throw new Error(await errDetail(resp));
      const j=await resp.json();
      const sym=j.symbol||r.sym, st=String(j.status||'');
      const kind=st.includes('SHADOW')?'sh':(j.filled?'live':'pending');
      toast(t('toast_buy_v2',kind,sym,sz,st),kind==='pending'?'err':'ok');
      scanCycle();
    }catch(e){toast(t('toast_buy_fail',e.message),'err');}
    return;
  }
  POS.push({sym:r.sym,addr:r.addr,address:r.address,size:sz,pnl:0,severity:18,escaping:false,sigs:[{k:'sig_normal',hot:false}]});
  RISK.open=POS.length;RISK.expo=+(RISK.expo+sz).toFixed(4);
  T[i].status='bought';
  logRow('BUY',r.sym,'Quick Buy '+sz+' SOL',COL.ACTION);
  toast('Quick Bought '+sz+' SOL of '+r.sym,'ok');
  renderAll(true);
}

/* ── escape / sell ── */
function escape_(i){
  const p=POS[i];if(!p)return;
  confirmDialog(t('sell_title',p.sym),t('sell_msg',p.sym,p.size,p.escaping),()=>doSellPos(i));
}
function doSellPos(i){
  const p=POS[i];if(!p)return;
  if(source==='backend'){
    fetch(API+'/api/sell',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({address:p.address||p.addr})})
      .then(async r=>{if(!r.ok)throw new Error(await errDetail(r));toast(t('toast_sell_sent',p.sym),'ok');scanCycle();})
      .catch(e=>toast(t('toast_sell_fail',e.message),'err'));
    return;
  }
  RISK.expo=+Math.max(0,RISK.expo-p.size).toFixed(4);
  logRow('SELL',p.sym,t('sell_log',p.escaping,(p.pnl>=0?'+':'')+(p.pnl*100).toFixed(1)+'%'),p.escaping?COL.SKIP:COL.ACTION);
  POS.splice(i,1);RISK.open=POS.length;
  toast(t('toast_sold',p.sym),'ok');renderAll(true);
}

/* ── 取消监控（不卖出，仅从逃生列表移除）── */
function unmonitor_(i){
  const p=POS[i];
  confirmDialog(t('unmon_title',p.sym),t('unmon_msg',p.sym),()=>doUnmonitor(i));
}
function doUnmonitor(i){
  const p=POS[i];if(!p)return;
  if(source==='backend'){
    fetch(API+'/api/unmonitor',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({address:p.address||p.addr})})
      .then(r=>{if(!r.ok)throw new Error('HTTP '+r.status);toast(t('toast_unmon',p.sym),'ok');scanCycle();})
      .catch(e=>toast(t('toast_unmon_fail',e.message),'err'));
    return;
  }
  POS.splice(i,1);RISK.open=POS.length;toast(t('toast_unmon',p.sym),'ok');renderAll(true);
}

/* ── toast ── */
let toastT;
function toast(m,kind){const el=document.getElementById('toast');el.textContent=(kind==='ok'?'✓ ':'⚠ ')+m;el.className='toast on '+(kind||'err');clearTimeout(toastT);toastT=setTimeout(()=>el.className='toast '+(kind||'err'),4200);}
/* 点击 Ticker 复制到剪贴板 */
function copyTicker(el){
  const tk=(el.textContent||'').trim();if(!tk)return;
  const done=()=>toast(t('toast_copied',tk),'ok');
  if(navigator.clipboard&&navigator.clipboard.writeText){
    navigator.clipboard.writeText(tk).then(done).catch(()=>fallbackCopy(tk,done));
  }else fallbackCopy(tk,done);
}
function fallbackCopy(tk,done){
  const ta=document.createElement('textarea');ta.value=tk;ta.style.position='fixed';ta.style.opacity='0';
  document.body.appendChild(ta);ta.select();
  try{document.execCommand('copy');done();}catch(e){toast(t('toast_copy_fail'),'err');}
  document.body.removeChild(ta);
}

/* 闸门图标即时 tooltip（原生 title 太慢）——事件委托挂在稳定容器上，行重渲染也不丢 */
(function(){
  const tip=document.getElementById('tip'), host=document;   // 全局委托：表头图标等任意 [data-tip] 都生效
  if(!tip)return;
  function place(el){
    const r=el.getBoundingClientRect();
    let left=r.left+r.width/2-tip.offsetWidth/2;
    left=Math.max(8,Math.min(window.innerWidth-tip.offsetWidth-8,left));
    let top=r.top-tip.offsetHeight-8;
    if(top<8)top=r.bottom+8;            // 顶部放不下就放图标下方
    tip.style.left=left+'px';tip.style.top=top+'px';
  }
  host.addEventListener('mouseover',e=>{
    const p=e.target.closest('[data-tip]');if(!p)return;
    tip.textContent=p.getAttribute('data-tip');tip.classList.add('on');place(p);
  });
  host.addEventListener('mouseout',e=>{
    if(e.target.closest('[data-tip]'))tip.classList.remove('on');
  });
})();

/* ── i18n 应用：刷新所有静态文案 + 重渲染动态区 ── */
function applyI18n(){
  document.documentElement.lang = (lang==='zh'?'zh-CN':'en');
  document.title=t('title');
  document.querySelectorAll('[data-i18n]').forEach(el=>{el.innerHTML=t(el.getAttribute('data-i18n'));});
  const tagEl=document.querySelector('.tag');if(tagEl)tagEl.innerHTML=APP_VERSION+' · '+t('tag');   // 版本号放副标题句首，沿用副标题文案色值
  document.querySelectorAll('[data-i18n-title]').forEach(el=>{el.title=t(el.getAttribute('data-i18n-title'));});
  document.querySelectorAll('[data-i18n-tip]').forEach(el=>{el.setAttribute('data-tip',t(el.getAttribute('data-i18n-tip')));});
  document.querySelectorAll('[data-i18n-ph]').forEach(el=>{el.placeholder=t(el.getAttribute('data-i18n-ph'));});
  document.getElementById('langBtn').textContent=(lang==='zh'?'中文':'EN');
  const tf=document.getElementById('tokFilter');if(tf)tf.setAttribute('data-tip',t(onlyHeld?'tokf_on':'tokf_off'));
  applyLiveLabel();
  renderAll(false);
  if(typeof wltData!=='undefined'&&wltData&&typeof renderWallet==='function')renderWallet();  // 已评估的钱包随语言重渲染
  if(source==='demo'){feed.innerHTML='';logScreen();}   // 重置日志为当前语言
}
function switchLang(){lang=(lang==='zh'?'en':'zh');localStorage.setItem('aitrader_lang',lang);applyI18n();}

