};
function detectLang(){
  const saved=localStorage.getItem('aitrader_lang');
  if(saved==='zh'||saved==='en')return saved;
  const nav=(navigator.language||navigator.userLanguage||'').toLowerCase();
  return nav.indexOf('zh')===0?'zh':'en';   // 简体/繁体(zh-*) → 中文；其他 → 英文
}
let lang=detectLang();
const APP_VERSION='v0.0.1';   // 显示在副标题，方便排查问题；改动前端时一并 bump
function t(k,...a){const d=I18N[lang]||I18N.zh;let s=d[k];if(s===undefined)s=I18N.zh[k];if(s===undefined)return k;return typeof s==='function'?s(...a):s;}

