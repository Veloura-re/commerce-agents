  door:'<path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/>',
  siren:'<path d="M7 18v-6a5 5 0 0 1 10 0v6"/><path d="M5 21h14"/><path d="M12 2v1"/><path d="M4.6 5.6l.7.7"/><path d="M19.4 5.6l-.7.7"/>',
  cog:'<circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/>',
};
const svg=(n,c='currentColor')=>`<svg viewBox="0 0 24 24" fill="none" stroke="${c}" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">${I[n]}</svg>`;
const fill=n=>`<svg viewBox="0 0 24 24" fill="currentColor" stroke="none">${I[n]}</svg>`;

/* ── backend ── */
/* 同源请求：后端(127.0.0.1:8000)托管本页时走相对路径，经隧道访问也回到本机后端；
   仅 file:// 直接打开时回退到本地端口。连不上(纯静态/GitHub Pages)→ 自动 DEMO。 */
const API=location.protocol==='file:'?"http://127.0.0.1:8000":"";
let source="backend", bePolling=true, liveMode=false, tradingLocked=false;
let pollMs=5600, pollTimer=null, defaultTrendCmd="", curChain="sol", beReady=true, buyAmount=0.01;
let onlyHeld=false;            // TOKEN 旁警告图标：只看当前持仓的币
function toggleOnlyHeld(){
  onlyHeld=!onlyHeld;
  const el=document.getElementById('tokFilter');
  el.classList.toggle('on',onlyHeld);
  el.setAttribute('data-tip', t(onlyHeld?'tokf_on':'tokf_off'));
  renderRows();
}
const escAlertSet=new Set();   // 持仓卡片当前处于弱红告警的 address（用于"首次进入才闪一下"）
/* 持仓在左侧筛选里是否"非全绿/掉榜"：不在筛选列表 或 在但未通过全部闸门 → 告警 */
function posIsAlert(p){
  const addr=p.address||p.addr||'';
  if(!addr)return false;
  const t=T.find(x=>(x.address||'')===addr);
  if(!t)return true;                 // 已掉出筛选榜
  return t.status!=='action';        // 在榜但非全绿（被某门砍）
}
/* ── 多链：单位 / 标签 / 本地存储 ── */
const NATIVE_UNIT={sol:'SOL',bsc:'BNB',base:'ETH',eth:'ETH',robinhood:'ETH'};
const CHAIN_LABEL={sol:'SOL',bsc:'BSC',base:'Base',eth:'ETH',robinhood:'Robinhood'};
const loadBuyAmt=ch=>{const v=parseFloat(localStorage.getItem('aitrader_buyamt_'+ch));return (isNaN(v)||v<0)?0.01:v;};
function onAmt(el){let v=parseFloat(el.value);buyAmount=(isNaN(v)||v<0)?0:v;localStorage.setItem('aitrader_buyamt_'+curChain,buyAmount);renderRows();}
function updateAmtUnit(){const u=document.getElementById('amtUnit');if(u)u.textContent=NATIVE_UNIT[curChain]||'SOL';}
/* ── 链下拉菜单 ── */
function toggleChainMenu(){const m=document.getElementById('chainMenu');m.classList.toggle('on');
  [...m.children].forEach(d=>d.classList.toggle('sel',d.dataset.ch===curChain));}
function closeChainMenu(){document.getElementById('chainMenu').classList.remove('on');}
function switchChain(ch){
  closeChainMenu();
  if(ch===curChain)return;
  // 链随请求传递：切链只改本 tab 状态 + 重扫，无需通知后端（无全局链了）
  curChain=ch;
  sessionStorage.setItem('aitrader_chain',ch);   // 本 tab 的链（多 tab 互不干扰）
  localStorage.setItem('aitrader_chain',ch);     // 顺便更新「新 tab 默认链」
  document.getElementById('chainPill').textContent=CHAIN_LABEL[ch];
  buyAmount=loadBuyAmt(ch);
  const ai=document.getElementById('amtInput');if(ai)ai.value=buyAmount;
  updateAmtUnit();
  loadingScreen=true;                            // 切链先回骨架，别拿旧链数据糊脸
  toast(t('toast_chain_switched',CHAIN_LABEL[ch]),'ok');
  if(source==='backend'&&bePolling)scanCycle(); else renderAll(true);
}
/* CA 缩写：前 5 … 后 4；GMGN 代币页链接 */
const shortCA=a=>a?(a.length>11?a.slice(0,5)+'…'+a.slice(-4):a):'';
const fmtPrice=v=>{if(!v)return '';const n=Number(v);return '$'+(n>=1?n.toFixed(4):n.toPrecision(3));};
const fmtMc=v=>{const n=Number(v)||0;if(n<=0)return '—';if(n>=1e9)return '$'+(n/1e9).toFixed(1)+'B';if(n>=1e6)return '$'+(n/1e6).toFixed(1)+'M';if(n>=1e3)return '$'+(n/1e3).toFixed(0)+'k';return '$'+n.toFixed(0);};
/* DEV史 列：dev 历史评估（排序子分）。score 0..1 → 标签+0..100 分；hover 出历史最佳市值/发币次数/是否清仓。
   仅对排序靠前的幸存者评估过（其余为 null）→ 显示 — */
function devCell(t){
  if(t.devScore==null) return `<span class="m has-tip" style="color:var(--dim2)" data-tip="${t2('devhist_none')}">—</span>`;
  const s=t.devScore, sc=Math.round(s*100);
  const lbl=s>=0.7?t2('dev_good'):s>=0.45?t2('dev_mid'):t2('dev_weak');
  const cls=s>=0.7?'good':s<0.45?'bad':'';
  const reskin=t.devReskin?`<span class="reskin" data-tip="${t2('reskin_tip')}">${t2('reskin_tag')}</span>`:'';
  return `<span class="m has-tip ${cls}" data-tip="${t2('devhist_tip',sc,t.devLaunches??'?',fmtMc(t.devAth),t.devExited,t.devReskin,t.devRugRate==null?'?':Math.round(t.devRugRate*100))}">${lbl} ${sc}</span>${reskin}`;
}
/* Dev 信誉卡（点击代币行 → 右下角详情）：复刻 demo 的「信誉分 + 历史发币/rug/存活/换皮重发」。
   数据来自 portfolio created-tokens 查 dev 钱包发币历史。devScore==null（未评估）则不渲染卡。 */
function devCard(r){
  if(r.devScore==null) return '';
  const sc=Math.round(r.devScore*100);
  const cls=r.devScore>=0.7?'good':r.devScore<0.45?'bad':'mid';
  const trust=r.devScore>=0.45?t('dev_trust'):t('dev_distrust');
  const launches=r.devLaunches??'?';
  const rugN=r.devRugged??'?', rugPct=(r.devRugRate==null)?'':` <em>(${Math.round(r.devRugRate*100)}%)</em>`;
  const inner=(r.devInner!=null&&r.devInner>launches)?`<span class="dcinner has-tip" data-tip="${t('dev_inner_tip')}">+${r.devInner}</span>`:'';
  // 安全扫描风险行（仅在最近发币里检出不安全时显示）
  const sec=(r.devSecUnsafe>0)?`<div class="dcrisk">${t('dev_sec_warn',r.devSecUnsafe,r.devSecChecked,(r.devSecRisks||[]).map(riskLabel).join(' · '))}</div>`:'';
  return `<div class="devcard ${cls}">
    <div class="dctop"><span class="dcscore">${sc}<small>/100</small></span><span class="dclbl">${t('dev_rep_label')}</span><span class="dctrust">${trust}</span></div>
    <div class="dcstats">
      <span><i>${t('dev_k_launches')}</i>${launches}${inner}</span>
      <span class="${rugN>0?'bad':'good'}"><i>${t('dev_k_rug')}</i>${rugN}${rugPct}</span>
      <span><i>${t('dev_k_alive')}</i>${r.devAlive??'?'}</span>
      <span class="${r.devReskin?'bad':'good'}"><i>${t('dev_k_reskin')}</i>${r.devReskin?t('dev_reskin_yes'):t('dev_reskin_no')}</span>
    </div>${sec}</div>`;
}
/* Council Advisory Rating Pill for Screening Table */
function ratingCell(t){
  const sc = t.councilScore != null ? t.councilScore : (t.status === 'action' ? 80 : 25);
  const tier = sc >= 80 ? 'LOW' : sc >= 60 ? 'MOD' : sc >= 40 ? 'ELEV' : 'HIGH';
  const tierCls = sc >= 80 ? 'tier-low' : sc >= 60 ? 'tier-mod' : sc >= 40 ? 'tier-elev' : 'tier-high';
  const fullTier = sc >= 80 ? 'LOW_RISK' : sc >= 60 ? 'MODERATE_RISK' : sc >= 40 ? 'ELEVATED_RISK' : 'HIGH_RISK';
  const gates = t.councilGates != null ? t.councilGates : (sc >= 80 ? 5 : sc >= 60 ? 4 : sc >= 40 ? 2 : 1);
  const tip = `COUNCIL ADVISORY: ${sc}/100 | ${fullTier} | ${gates}/5 Sentinels Passed (Advisory only — never blocks trades)`;
  return `<span class="rating-badge ${tierCls} has-tip" data-tip="${tip}"><span class="score">${sc}</span><span class="tier">${tier}</span><span class="gates-cnt">${gates}/5</span></span>`;
}
/* Council Advisory Rating Card (Detail View) */
function councilCard(r){
  const sc = r.councilScore != null ? r.councilScore : (r.status === 'action' ? 80 : 25);
  let riskLabel = r.councilRisk || (sc >= 80 ? 'LOW_RISK' : sc >= 60 ? 'MODERATE_RISK' : sc >= 40 ? 'ELEVATED_RISK' : 'HIGH_RISK');
  const gates = r.councilGates != null ? r.councilGates : (sc >= 80 ? 5 : sc >= 60 ? 4 : sc >= 40 ? 2 : 1);
  const cls = sc >= 80 ? 'good' : sc >= 60 ? 'mid' : 'bad';
  const c = r.council || {};
  const debates = c.debates || [
    {subagent:"Product Strategist (Macro Liquidity)",verdict:sc>=60?"PASS":"FAIL",score:Math.min(10,Math.max(1,(sc/10)+0.2)).toFixed(1),argument:sc>=60?"Liquidity depth & volume acceleration within viable bounds.":"Thin pool liquidity / limited volume acceleration."},
    {subagent:"Principal Architect (Execution Bounds)",verdict:sc>=70?"PASS":"FAIL",score:Math.min(10,Math.max(1,(sc/10)-0.1)).toFixed(1),argument:sc>=70?"Slippage bounds and route latency optimal.":"Slippage vector exceeds tight scalping tolerance."},
    {subagent:"Dark-Hat Exploiter (Security & Bundler)",verdict:(!r.hp&&r.bund<=0.3)?"PASS":"FAIL",score:(!r.hp&&r.bund<=0.3)?"8.8":"2.5",argument:(!r.hp&&r.bund<=0.3)?"Verified contract, mint renounced, low bundler footprint.":"High bundler cluster or unrenounced contract."},
    {subagent:"Design Perfectionist (Order Flow Velocity)",verdict:sc>=50?"PASS":"FAIL",score:Math.min(10,Math.max(1,(sc/10)+0.1)).toFixed(1),argument:sc>=50?"Positive buyer ratio and healthy order velocity.":"Buyer momentum decelerating below threshold."},
    {subagent:"Pragmatic Contrarian (Anti-FOMO Check)",verdict:r.crowd!=='late'?"PASS":"FAIL",score:r.crowd!=='late'?"8.5":"3.0",argument:r.crowd!=='late'?"Early entry window; not crowded.":"Crowded trade detected; late entry risk."}
  ];

  const debatesHtml = debates.map(d=>{
    const isPass = d.verdict === 'PASS';
    return `<div class="council-debate-row ${isPass ? 'pass' : 'fail'}">
      <span class="cd-agent">${d.subagent}</span>
      <span class="cd-verdict">${isPass ? 'PASS' : 'FAIL'} (${d.score || '—'}/10)</span>
      <span class="cd-arg">${d.argument || ''}</span>
    </div>`;
  }).join('');

  return `<div class="councilcard ${cls}">
    <div class="cctop">
      <div class="ccscore-box">
        <span class="ccscore">${sc}<small>/100</small></span>
        <span class="cclbl">COUNCIL ADVISORY RATING</span>
      </div>
      <div class="cctier-badge ${cls}">${riskLabel}</div>
      <div class="ccgates-info">${gates}/5 SENTINELS PASSED</div>
      <div class="ccadvisory-note">Advisory Only — Bot Never Vetoes Trades</div>
    </div>
    <div class="ccdebates">${debatesHtml}</div>
  </div>`;
}
/* 创建至今多久，只显示最大单位：d 天 / h 小时 / m 分钟 / s 秒（age 单位=分钟）*/
function fmtAge(min){
  if(min==null||isNaN(min))return '';
  const s=Math.max(0,Math.round(min*60));
  if(s>=86400)return Math.floor(s/86400)+'d';
  if(s>=3600)return Math.floor(s/3600)+'h';
  if(s>=60)return Math.floor(s/60)+'m';
  return s+'s';
}
const caCell=t_=>{
  const ca=t_.address
    ?`<a class="ca" href="https://gmgn.ai/${curChain}/token/${t_.address}" target="_blank" rel="noopener" title="${t('ca_open_title',t_.address)}" onclick="event.stopPropagation()">${shortCA(t_.address)}</a>`
    :`<small>${t_.addr||''}</small>`;
  const ageStr=fmtAge(t_.age);
  const fresh=(t_.age!=null&&!isNaN(t_.age)&&t_.age<60);   // 1 小时内 = 新币，标绿
  const age=ageStr?`<span class="age${fresh?' fresh':''}" title="${t(fresh?'age_title_fresh':'age_title')}">${ageStr}</span>`:'';
  return `<span class="carow">${ca}${age}</span>`;
};
function dexBadge(dex){
  const d = String(dex || 'RAY-CPMM').toUpperCase();
  let cls = 'dex-pump';
  if(d.includes('RAY-CPMM') || d.includes('CPMM')) cls = 'dex-ray';
  else if(d.includes('RAY-V4') || d.includes('RAY')) cls = 'dex-ray';
  else if(d.includes('METEORA')) cls = 'dex-meteora';
  else if(d.includes('MOON')) cls = 'dex-moonshot';
  else if(d.includes('STONK')) cls = 'dex-stonk';
  else if(d.includes('ORCA')) cls = 'dex-orca';
  else if(d.includes('LIFINITY')) cls = 'dex-lifinity';
  else if(d.includes('FLUX')) cls = 'dex-flux';
  else if(d.includes('PUMP')) cls = 'dex-pump';
  else cls = 'dex-ray';
  return `<span class="dex-badge ${cls}">${d}</span>`;
}

/* ── pipeline gates (6, 含 ML 抑制) ── */
const GATE_ICONS=['scan','shield','users','filter','brain','target'];
const gateName=i=>t('gate'+i);

/* 演示/真实数据里 thesis/reason/exit/signal 可能是 i18n key（demo）或后端原文（live），统一取词 */
/* 后端模式：理由是 app.py 发的中文。中文 UI 用原文（最准）；英文 UI 用结构化字段重建英文理由。
   DEMO 模式有 reasonK 直接取词。 */
function buildReason(r){
  switch(r.died){
    case 1:{const iss=[];if(r.hp)iss.push('honeypot');if(r.bund>0.30)iss.push('bundler '+P(r.bund));if(r.dev>0.10)iss.push('dev '+P(r.dev));if(r.top10>0.40)iss.push('top10 '+P(r.top10));return t('bk_safety',iss.length?iss.join(' / '):t('bk_safety_generic'));}
    case 2:return t('bk_consensus',r.smc,r.degen,r.kol);
    case 3:return t('bk_rank');
    case 4:return r.crowd==='late'?t('bk_llm_late'):t('bk_llm_reject');
    default:return t('bk_filtered');
  }
}
function reasonOf(r){
  if(r.reasonK)return t(r.reasonK);          // DEMO：i18n key
  if(lang==='zh'&&r.reason)return r.reason;  // 后端中文 UI：用后端原文
  return buildReason(r);                      // 后端英文 UI（或无原文）：重建
}
const thesisOf=r=>r.thesisK?t(r.thesisK):(r.thesis||'');
const exitOf=r=>r.exitK?t(r.exitK):(r.exit||t('exit_ladder'));
const sigText=s=>s.k?t(s.k):s.t;

const COL={ACTION:'var(--lime)',WARN:'var(--amber)',SKIP:'var(--clay)',BLOCK:'var(--amber)'};

/* ── demo screening data ──
   status: 'action'=通过全部闸门, 摆出来等你买  |  'reject'=被某道门刷掉
   warn=true: 通过质量门, 但买入会触发组合风控(并发/敞口), 仅警示不阻断       */
/* 与后端 priority_score 同构：共识计数亚线性压缩，无合成安全分 */
function priCalc(t){const c=Math.min(28,9*Math.log10(1+(t.smc||0)));let s=t.conv*38+c+(1-Math.min(t.top10||0,1))*14+((t.ren)?6:0)+(t.crowd==='early'?10:t.crowd==='late'?-15:0);return Math.max(0,Math.min(99,Math.round(s)));}
