function resetWalletView(){
  wltData=null;
  const a=document.getElementById('wltAddr');if(a)a.value='';
  const res=document.getElementById('wltResult');if(res)res.innerHTML='<div class="wlt-empty">'+t('wlt_empty')+'</div>';
}
/* 粗略按地址格式猜链：sol = base58 无 0x 前缀；bsc/base/eth 都是 0x+40 位十六进制，格式上分不出具体是哪条 */
function detectAddrChain(a){
  if(/^0x[0-9a-fA-F]{40}$/.test(a))return 'evm';
  if(/^[1-9A-HJ-NP-Za-km-z]{32,44}$/.test(a))return 'sol';
  return null;
}
function scrollToBrainSec(id){
  if(curView !== 'brain') switchView('brain');
  setTimeout(() => {
    const el = document.getElementById(id);
    if(el) {
      el.scrollIntoView({behavior: 'smooth', block: 'start'});
    }
    document.querySelectorAll('.brain-subnav-btn').forEach(btn => {
      const match = btn.getAttribute('onclick') && btn.getAttribute('onclick').includes(id);
      btn.classList.toggle('active', !!match);
    });
  }, 90);
}

function switchView(v){
  if(v==='analytics' || v==='logs' || v==='history'){
    switchView('brain');
    if(v==='analytics') scrollToBrainSec('brainGains');
    else if(v==='logs') scrollToBrainSec('brainLogs');
    else if(v==='history') scrollToBrainSec('brainHistory');
    return;
  }
  curView = v; 
  try{ sessionStorage.setItem('aitrader_view', v); }catch(_){}
  
  const tt=document.getElementById('tabToken'); if(tt) tt.classList.toggle('on', v==='token');
  const tw=document.getElementById('tabWallet'); if(tw) tw.classList.toggle('on', v==='wallet');
  const tmw=document.getElementById('tabMyWallet'); if(tmw) tmw.classList.toggle('on', v==='mywallet');
  const tb=document.getElementById('tabBrain'); if(tb) tb.classList.toggle('on', v==='brain');

  const vt=document.getElementById('viewToken'); if(vt) vt.style.display = v==='token'?'flex':'none';
  const vw=document.getElementById('viewWallet'); if(vw) vw.style.display = v==='wallet'?'block':'none';
  const vmw=document.getElementById('viewMyWallet'); if(vmw) vmw.style.display = v==='mywallet'?'block':'none';
  const vb=document.getElementById('viewBrain'); if(vb) vb.style.display = v==='brain'?'block':'none';

  /* Hide top PnL HUD strip when viewing Brain or MyWallet */
  const hud=document.getElementById('topPnlHud');
  if(hud) hud.style.display=(v==='brain'||v==='mywallet')?'none':'flex';

  if(v==='wallet'){const a=document.getElementById('wltAddr');if(a)a.focus();}
  if(v==='mywallet'){
    loadMyWalletData();
    if(!myWalletTimer) myWalletTimer=setInterval(loadMyWalletData, 4000);
  } else {
    if(myWalletTimer){clearInterval(myWalletTimer); myWalletTimer=null;}
  }
  if(v==='brain'){
    if(typeof loadBrainData==='function') loadBrainData();
    if(typeof loadAnalyticsData==='function') loadAnalyticsData();
    if(typeof loadLogsData==='function') loadLogsData();
    if(typeof loadHistoryViewData==='function') loadHistoryViewData();

    if(!brainTimer && typeof loadBrainData==='function') brainTimer=setInterval(loadBrainData, 10000);
    if(!analyticsTimer && typeof loadAnalyticsData==='function') analyticsTimer=setInterval(loadAnalyticsData, 3000);
    if(!logsTimer && typeof loadLogsData==='function') logsTimer=setInterval(loadLogsData, 2500);
    if(!historyTimer && typeof loadHistoryViewData==='function') historyTimer=setInterval(loadHistoryViewData, 3000);
  } else {
    if(brainTimer){clearInterval(brainTimer); brainTimer=null;}
    if(analyticsTimer){clearInterval(analyticsTimer); analyticsTimer=null;}
    if(logsTimer){clearInterval(logsTimer); logsTimer=null;}
    if(historyTimer){clearInterval(historyTimer); historyTimer=null;}
  }
}

/* ══════════ FLIGHT BLACK BOX & TELEMETRY STREAM ENGINE ══════════ */
let autoScrollLogs = true;
let activeLogChannel = 'ALL';
let logSearchQuery = '';

function setLogChannel(ch){
  activeLogChannel = ch;
  ['chAll', 'chTrades', 'chCouncil', 'chRatchet', 'chStops'].forEach(id => {
    const el = document.getElementById(id);
    if(el) el.classList.remove('active');
  });
  const activeBtnMap = {
    ALL: 'chAll',
    TRADES: 'chTrades',
    COUNCIL: 'chCouncil',
    RATCHET: 'chRatchet',
    STOPS: 'chStops'
  };
  const activeEl = document.getElementById(activeBtnMap[ch]);
  if(activeEl) activeEl.classList.add('active');
  loadLogsData();
}

function toggleAutoScroll(){
  autoScrollLogs = !autoScrollLogs;
  const btn = document.getElementById('btnAutoScroll');
  if(btn){
    btn.textContent = autoScrollLogs ? 'AUTOSCROLL: ON' : 'AUTOSCROLL: OFF';
    btn.classList.toggle('active', autoScrollLogs);
  }
}

function clearTerminalView(){
  const term = document.getElementById('flightTerminalScreen');
  if(term) term.innerHTML = '<div class="terminal-row" style="color:var(--dim)">Terminal view cleared. Awaiting next telemetry tick...</div>';
}

function onLogSearchInput(val){
  logSearchQuery = (val || '').trim().toLowerCase();
  loadLogsData();
}

function formatTerminalLine(line){
  let safe = line.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  
  let rowClass = 'terminal-row';
  if(/SLOT FILLED|ENTERING FRESH ROTATION|PARTIAL_TP/i.test(line)){
    rowClass += ' row-trade';
  } else if(/COUNCIL ADVISORY|Supreme Judge/i.test(line)){
    rowClass += ' row-council';
  } else if(/RATCHET VAULT|RATCHET_FLOOR/i.test(line)){
    rowClass += ' row-ratchet';
  } else if(/MICRO_HARD_STOP|HOUSE_MONEY_STOP|BLOCK|REJECT/i.test(line)){
    rowClass += ' row-stop';
  } else if(/Cycle #/i.test(line)){
    rowClass += ' row-cycle';
  }

  safe = safe.replace(/^(\[\d{2}:\d{2}:\d{2}\])/, '<span class="ts">$1</span>');
  safe = safe.replace(/\bINFO:\b/, '<span class="lvl-info">INFO:</span>');
  safe = safe.replace(/\bWARNING:\b/, '<span class="lvl-warn">WARN:</span>');
  safe = safe.replace(/\bERROR:\b/, '<span class="lvl-err">ERROR:</span>');

  return `<div class="${rowClass}">${safe}</div>`;
}

async function loadLogsData(){
  try{
    const res = await fetch(API + '/api/logs?limit=400');
    if(!res.ok) return;
    const data = await res.json();
    if(!data) return;

    const elapsedSec = Math.round(data.elapsed_seconds || 0);
    const m = Math.floor(elapsedSec / 60);
    const s = elapsedSec % 60;
    const timerStr = `${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')} / 60:00`;
    
    const timerEl = document.getElementById('flightTimerVal');
    if(timerEl) timerEl.textContent = timerStr;

    const totLinesEl = document.getElementById('flightTotalLines');
    if(totLinesEl) totLinesEl.textContent = `${data.total_lines || 0} lines`;

    const cycleEl = document.getElementById('flightCycleCount');
    if(cycleEl) cycleEl.textContent = `Cycle #${data.cycle_count || 0}`;

    const tokensEl = document.getElementById('flightTokensScanned');
    if(tokensEl) tokensEl.textContent = Number(data.tokens_scanned || 0).toLocaleString();

    const pnlEl = document.getElementById('flightRealizedPnl');
    if(pnlEl){
      const pnlSol = data.total_realized_pnl_sol || 0;
      pnlEl.textContent = `${pnlSol >= 0 ? '+' : ''}${pnlSol.toFixed(4)} SOL`;
      pnlEl.style.color = pnlSol >= 0 ? 'var(--lime)' : 'var(--clay)';
    }

    let lines = data.lines || [];
    if(activeLogChannel === 'TRADES'){
      lines = lines.filter(l => /ENTER ROTATION|SLOT FILLED|ROTATING OUT|PARTIAL_TP|RUNNER|Wave Rider/i.test(l));
    } else if(activeLogChannel === 'COUNCIL'){
      lines = lines.filter(l => /COUNCIL|Score|sentinels|Supreme Judge|Veto/i.test(l));
    } else if(activeLogChannel === 'RATCHET'){
      lines = lines.filter(l => /RATCHET|Vault|Floor/i.test(l));
    } else if(activeLogChannel === 'STOPS'){
      lines = lines.filter(l => /STOP|MICRO_HARD_STOP|HOUSE_MONEY_STOP|BLOCK|kill-switch|REJECT/i.test(l));
    }

    if(logSearchQuery){
      lines = lines.filter(l => l.toLowerCase().includes(logSearchQuery));
    }

    const term = document.getElementById('flightTerminalScreen');
    if(!term) return;

    if(lines.length === 0){
      term.innerHTML = `<div class="terminal-row" style="color:var(--dim)">No log events matching channel filter [${activeLogChannel}] or query.</div>`;
      return;
    }

    const html = lines.map(formatTerminalLine).join('');
    term.innerHTML = html;

    if(autoScrollLogs){
      term.scrollTop = term.scrollHeight;
    }
  }catch(e){
    console.error('loadLogsData error', e);
  }
}

/* ══════════ GAINS & LOSSES ANALYTICS ENGINE ══════════ */
let analyticsData = null;
let activeAnalyticsFilter = 'ALL';
let analyticsSearchQuery = '';

async function loadAnalyticsData(){
  try{
    const res = await fetch(API + '/api/analytics');
    if(!res.ok) return;
    const data = await res.json();
    if(!data || !data.ok) return;
    analyticsData = data;
    updateTopPnlHud(data);
    if(curView === 'analytics' || curView === 'brain'){
      renderAnalytics(data);
    }
  }catch(e){
    console.error('Failed to load analytics data', e);
  }
}

function updateTopPnlHud(data){
  if(!data || !data.summary) return;
  const s = data.summary;

  // 1. Top Bar Navigation Pill
  const topBarPnl = document.getElementById('topBarPnl');
  const topBarPill = document.getElementById('topBarPnlPill');
  if(topBarPnl){
    const isPos = (s.net_realized_pnl_sol || 0) >= 0;
    topBarPnl.textContent = (isPos ? '+' : '') + (s.net_realized_pnl_sol || 0).toFixed(4) + ' SOL';
    topBarPnl.style.color = isPos ? 'var(--lime)' : 'var(--clay)';
    if(topBarPill){
      topBarPill.style.borderColor = isPos ? '#c8f24a44' : '#ec5a4044';
      topBarPill.style.background = isPos ? '#c8f24a0d' : '#ec5a400d';
    }
  }

  // 2. Top Dashboard HUD
  const topPnlHud = document.getElementById('topPnlHud');
  if(!topPnlHud) return;

  const isNetPos = (s.net_realized_pnl_sol || 0) >= 0;
  topPnlHud.classList.toggle('negative', !isNetPos);

  const topSol = document.getElementById('topPnlSol');
  if(topSol){
    topSol.textContent = (isNetPos ? '+' : '') + (s.net_realized_pnl_sol || 0).toFixed(6) + ' SOL';
    topSol.className = 'tph-sol ' + (isNetPos ? 'green' : 'red');
  }

  const topUsd = document.getElementById('topPnlUsd');
  if(topUsd){
    topUsd.textContent = `≈ ${(s.net_realized_pnl_usd >= 0 ? '+' : '-')}$${Math.abs(s.net_realized_pnl_usd || 0).toFixed(2)} USD`;
  }

  const topWr = document.getElementById('topPnlWr');
  if(topWr){
    topWr.textContent = `${(s.win_rate_pct || 0).toFixed(1)}%`;
    topWr.style.color = s.win_rate_pct >= 50 ? 'var(--lime)' : 'var(--clay)';
  }

  const topTrades = document.getElementById('topPnlTrades');
  if(topTrades){
    topTrades.textContent = `${s.winning_trades_count || 0}W / ${s.losing_trades_count || 0}L (${s.total_trades || 0} Total)`;
  }

  const topGains = document.getElementById('topPnlGains');
  if(topGains) topGains.textContent = '+' + (s.total_sol_gained || 0).toFixed(6) + ' SOL';

  const topAvgWin = document.getElementById('topPnlAvgWin');
  if(topAvgWin) topAvgWin.textContent = `Avg: +${(s.avg_win_sol || 0).toFixed(5)} SOL (+${(s.avg_win_pct || 0).toFixed(1)}%)`;

  const topLosses = document.getElementById('topPnlLosses');
  if(topLosses) topLosses.textContent = '-' + (s.total_sol_lost || 0).toFixed(6) + ' SOL';

  const topAvgLoss = document.getElementById('topPnlAvgLoss');
  if(topAvgLoss) topAvgLoss.textContent = `Avg: -${(s.avg_loss_sol || 0).toFixed(5)} SOL (-${(s.avg_loss_pct || 0).toFixed(1)}%)`;

  const topPf = document.getElementById('topPnlPf');
  if(topPf){
    topPf.textContent = `${(s.profit_factor || 0).toFixed(2)}x`;
    topPf.style.color = s.profit_factor >= 1.5 ? 'var(--lime)' : (s.profit_factor >= 1.0 ? 'var(--paper)' : 'var(--clay)');
  }

  const topRr = document.getElementById('topPnlRr');
  if(topRr) topRr.textContent = `R:R: ${(s.risk_reward_ratio || 0).toFixed(2)} | C#${s.cycle_count || 0}`;

  const topRating = document.getElementById('topPnlRating');
  if(topRating){
    const avgScore = s.avg_council_score != null ? s.avg_council_score : 65.0;
    topRating.textContent = `${avgScore.toFixed(0)} / 100`;
    topRating.className = 'tph-v ' + (avgScore >= 70 ? 'green' : (avgScore >= 50 ? 'amber' : 'red'));
  }
  const topRatingSub = document.getElementById('topPnlRatingSub');
  if(topRatingSub){
    const avgScore = s.avg_council_score != null ? s.avg_council_score : 65.0;
    const tier = avgScore >= 80 ? 'Low Risk' : (avgScore >= 60 ? 'Mod Risk' : (avgScore >= 40 ? 'Elevated' : 'High Risk'));
    topRatingSub.textContent = `${tier} · 23 Sentinels`;
  }

  const topNetPort = document.getElementById('topPnlNetPort');
  if(topNetPort){
    const isPortPos = (s.net_portfolio_pnl_sol || 0) >= 0;
    topNetPort.textContent = (isPortPos ? '+' : '') + (s.net_portfolio_pnl_sol || 0).toFixed(6) + ' SOL';
    topNetPort.style.color = isPortPos ? 'var(--lime)' : 'var(--clay)';
  }

  const topUnrealized = document.getElementById('topPnlUnrealized');
  if(topUnrealized){
    const activeCnt = (data.active_positions || []).length;
    topUnrealized.textContent = `Unrealized: ${(s.unrealized_pnl_sol >= 0 ? '+' : '')}${(s.unrealized_pnl_sol || 0).toFixed(6)} SOL (${activeCnt} active)`;
  }

  const topShiftBadge = document.getElementById('topPnlShiftBadge');
  if(topShiftBadge){
    const elapsed = Math.floor(s.session_elapsed_seconds || 0);
    const hrs = Math.floor(elapsed / 3600);
    const m = Math.floor((elapsed % 3600) / 60);
    const sec = elapsed % 60;
    topShiftBadge.textContent = `NIGHT SHIFT (${hrs}h ${m}m ${sec < 10 ? '0' : ''}${sec}s / 5h ACTIVE)`;
  }
}

function renderAnalytics(data){
  if(!data || !data.summary) return;
  const s = data.summary;

  // 1. Shift Timer
  const elapsed = Math.floor(s.session_elapsed_seconds || 0);
  const hrs = Math.floor(elapsed / 3600);
  const m = Math.floor((elapsed % 3600) / 60);
  const sec = elapsed % 60;
  const timerStr = `${hrs}h ${m}m ${sec < 10 ? '0' : ''}${sec}s / 5h NIGHT-SHIFT (C#${s.cycle_count || 0})`;
  const timerEl = document.getElementById('pnlShiftTimer');
  if(timerEl) timerEl.textContent = timerStr;

  // 2. Net Realized Card
  const netSolEl = document.getElementById('pnlNetRealizedSol');
  const netUsdEl = document.getElementById('pnlNetRealizedUsd');
  const netCard = document.getElementById('pnlNetRealizedCard');
  if(netSolEl){
    netSolEl.textContent = (s.net_realized_pnl_sol >= 0 ? '+' : '') + s.net_realized_pnl_sol.toFixed(6) + ' SOL';
    netSolEl.className = 'pnl-kpi-val ' + (s.net_realized_pnl_sol >= 0 ? 'green' : 'red');
  }
  if(netUsdEl){
    netUsdEl.textContent = `≈ ${(s.net_realized_pnl_usd >= 0 ? '+' : '-')}$${Math.abs(s.net_realized_pnl_usd || 0).toFixed(2)} USD`;
  }
  if(netCard){
    netCard.classList.toggle('negative', s.net_realized_pnl_sol < 0);
  }

  // 3. Win Rate Card
  const wrEl = document.getElementById('pnlWinRate');
  if(wrEl){
    wrEl.textContent = `${(s.win_rate_pct || 0).toFixed(1)}%`;
    wrEl.style.color = s.win_rate_pct >= 50 ? 'var(--lime)' : 'var(--clay)';
  }
  const wlCountEl = document.getElementById('pnlWinLossCount');
  if(wlCountEl){
    wlCountEl.textContent = `${s.winning_trades_count || 0} Wins / ${s.losing_trades_count || 0} Losses (${s.total_trades || 0} Total)`;
  }

  // 4. Profit Factor Card
  const pfEl = document.getElementById('pnlProfitFactor');
  if(pfEl){
    pfEl.textContent = `${(s.profit_factor || 0).toFixed(2)}x`;
    pfEl.style.color = s.profit_factor >= 1.5 ? 'var(--lime)' : (s.profit_factor >= 1.0 ? 'var(--paper)' : 'var(--clay)');
  }
  const rrEl = document.getElementById('pnlRiskReward');
  if(rrEl){
    rrEl.textContent = `R:R Ratio: ${(s.risk_reward_ratio || 0).toFixed(2)} | Scanned: ${s.tokens_scanned || 0}`;
  }

  // 5. Total Gross Gains
  const ggEl = document.getElementById('pnlGrossGains');
  if(ggEl) ggEl.textContent = '+' + (s.total_sol_gained || 0).toFixed(6) + ' SOL';
  const awEl = document.getElementById('pnlAvgWin');
  if(awEl) awEl.textContent = `Avg Win: +${(s.avg_win_sol || 0).toFixed(6)} SOL (+${(s.avg_win_pct || 0).toFixed(1)}%)`;

  // 6. Total Gross Losses
  const glEl = document.getElementById('pnlGrossLosses');
  if(glEl) glEl.textContent = '-' + (s.total_sol_lost || 0).toFixed(6) + ' SOL';
  const alEl = document.getElementById('pnlAvgLoss');
  if(alEl) alEl.textContent = `Avg Loss: -${(s.avg_loss_sol || 0).toFixed(6)} SOL (-${(s.avg_loss_pct || 0).toFixed(1)}%)`;

  // 7. Floating & Net Portfolio
  const npSolEl = document.getElementById('pnlNetPortfolioSol');
  if(npSolEl){
    npSolEl.textContent = (s.net_portfolio_pnl_sol >= 0 ? '+' : '') + (s.net_portfolio_pnl_sol || 0).toFixed(6) + ' SOL';
    npSolEl.style.color = s.net_portfolio_pnl_sol >= 0 ? 'var(--lime)' : 'var(--clay)';
  }
  const flSolEl = document.getElementById('pnlFloatingSol');
  if(flSolEl){
    const activeCnt = (data.active_positions || []).length;
    flSolEl.textContent = `Unrealized: ${(s.unrealized_pnl_sol >= 0 ? '+' : '')}${(s.unrealized_pnl_sol || 0).toFixed(6)} SOL (${activeCnt} Active)`;
  }

  // 8. Equity Curve
  renderEquityCurve(data.equity_curve || []);

  // 9. Exit Reasons Breakdown
  renderExitReasons(data.exit_reasons || {}, s);

  // 10. Outlier Trades
  renderOutliers(s.largest_win, s.largest_loss);

  // 11. Council Risk Tiers Breakdown
  renderRiskTiers(data.risk_tiers || {}, s);

  // 12. Tab Counts
  const cntAll = document.getElementById('cntAllTrades'); if(cntAll) cntAll.textContent = s.total_trades || 0;
  const cntGains = document.getElementById('cntGainsTrades'); if(cntGains) cntGains.textContent = s.winning_trades_count || 0;
  const cntLosses = document.getElementById('cntLossesTrades'); if(cntLosses) cntLosses.textContent = s.losing_trades_count || 0;
  const cntActive = document.getElementById('cntActivePositions'); if(cntActive) cntActive.textContent = (data.active_positions || []).length;

  // 13. Trade Explorer
  renderAnalyticsTrades();
}

function renderEquityCurve(curve){
  const svg = document.getElementById('equitySvg');
  if(!svg) return;
  if(!curve || curve.length === 0){
    svg.innerHTML = '<text x="500" y="110" fill="var(--dim)" font-family="var(--mono)" font-size="12" text-anchor="middle">AWAITING COMPLETED TRADES FOR TRAJECTORY PLOT...</text>';
    const hw = document.getElementById('pnlHighWater'); if(hw) hw.textContent = '0.0000 SOL';
    const cur = document.getElementById('pnlCurrentEquity'); if(cur) cur.textContent = '0.0000 SOL';
    return;
  }

  const points = [{trade_num: 0, symbol: 'START', cumulative_sol: 0.0, pnl_sol: 0.0, pnl_pct: 0.0, outcome: 'START'}, ...curve];
  const lastPoint = points[points.length - 1];
  const highWater = Math.max(...points.map(p => p.cumulative_sol));
  
  const hw = document.getElementById('pnlHighWater'); 
  if(hw) hw.textContent = (highWater >= 0 ? '+' : '') + highWater.toFixed(6) + ' SOL';
  const cur = document.getElementById('pnlCurrentEquity'); 
  if(cur) cur.textContent = (lastPoint.cumulative_sol >= 0 ? '+' : '') + lastPoint.cumulative_sol.toFixed(6) + ' SOL';

  let minVal = Math.min(0, ...points.map(p => p.cumulative_sol));
  let maxVal = Math.max(0, ...points.map(p => p.cumulative_sol));
  let range = maxVal - minVal;
  if(range === 0) range = 0.001;
  minVal -= range * 0.15;
  maxVal += range * 0.15;
  range = maxVal - minVal;

  const w = 1000, h = 220;
  const padL = 60, padR = 40, padT = 30, padB = 40;
  const chartW = w - padL - padR;
  const chartH = h - padT - padB;

  const zeroY = padT + (1 - (0 - minVal) / range) * chartH;

  const coords = points.map((p, idx) => {
    const x = padL + (idx / (points.length - 1 || 1)) * chartW;
    const y = padT + (1 - (p.cumulative_sol - minVal) / range) * chartH;
    return { x, y, p };
  });

  const pathD = coords.map((c, i) => (i === 0 ? 'M' : 'L') + ` ${c.x.toFixed(1)} ${c.y.toFixed(1)}`).join(' ');
  const areaD = `${pathD} L ${coords[coords.length - 1].x.toFixed(1)} ${zeroY.toFixed(1)} L ${coords[0].x.toFixed(1)} ${zeroY.toFixed(1)} Z`;

  const isNetWin = lastPoint.cumulative_sol >= 0;
  const strokeColor = isNetWin ? 'var(--lime)' : 'var(--clay)';
  const gradId = isNetWin ? 'gradEquityGreen' : 'gradEquityRed';

  let svgHtml = `
    <defs>
      <linearGradient id="gradEquityGreen" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#c8f24a" stop-opacity="0.35"/>
        <stop offset="100%" stop-color="#c8f24a" stop-opacity="0.0"/>
      </linearGradient>
      <linearGradient id="gradEquityRed" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#ec5a40" stop-opacity="0.35"/>
        <stop offset="100%" stop-color="#ec5a40" stop-opacity="0.0"/>
      </linearGradient>
    </defs>
    <!-- Zero baseline -->
    <line x1="${padL}" y1="${zeroY.toFixed(1)}" x2="${w - padR}" y2="${zeroY.toFixed(1)}" stroke="rgba(255,255,255,0.12)" stroke-dasharray="4 4" stroke-width="1.2"/>
    <text x="${padL - 8}" y="${(zeroY + 4).toFixed(1)}" fill="var(--dim)" font-family="var(--mono)" font-size="9" text-anchor="end">0.000 SOL</text>
    
    <!-- Top and Bottom guides -->
    <text x="${padL - 8}" y="${padT + 8}" fill="var(--dim)" font-family="var(--mono)" font-size="9" text-anchor="end">${(maxVal >= 0 ? '+' : '') + maxVal.toFixed(4)}</text>
    <text x="${padL - 8}" y="${h - padB}" fill="var(--dim)" font-family="var(--mono)" font-size="9" text-anchor="end">${(minVal >= 0 ? '+' : '') + minVal.toFixed(4)}</text>
    
    <!-- Fill Area -->
    <path d="${areaD}" fill="url(#${gradId})"/>
    
    <!-- Trajectory Stroke -->
    <path d="${pathD}" fill="none" stroke="${strokeColor}" stroke-width="2.5" stroke-linejoin="round" stroke-linecap="round"/>
  `;

  coords.forEach((c, i) => {
    const isStart = i === 0;
    const dotColor = isStart ? 'var(--dim)' : (c.p.pnl_sol >= 0 ? 'var(--lime)' : 'var(--clay)');
    const r = isStart ? 3 : 5;
    const tipText = isStart 
      ? 'SESSION START: 0.0000 SOL' 
      : `#${c.p.trade_num} ${esc(c.p.symbol)}: ${(c.p.pnl_sol >= 0 ? '+' : '') + c.p.pnl_sol.toFixed(5)} SOL (${(c.p.pnl_pct * 100).toFixed(1)}%) | Cumulative: ${(c.p.cumulative_sol >= 0 ? '+' : '') + c.p.cumulative_sol.toFixed(5)} SOL`;
    
    svgHtml += `<circle cx="${c.x.toFixed(1)}" cy="${c.y.toFixed(1)}" r="${r}" fill="${dotColor}" stroke="var(--ink)" stroke-width="2" style="cursor:pointer;transition:r 0.15s" onmouseenter="showChartTooltip(event, '${tipText}')" onmouseleave="hideChartTooltip()"/>`;
  });

  svg.innerHTML = svgHtml;
}

function showChartTooltip(e, text){
  const tip = document.getElementById('equityTooltip');
  const wrap = document.getElementById('equitySvgWrap');
  if(!tip || !wrap) return;
  tip.textContent = text;
  tip.style.display = 'block';
  const wrapRect = wrap.getBoundingClientRect();
  let left = e.clientX - wrapRect.left + 10;
  let top = e.clientY - wrapRect.top - 30;
  if(left + 240 > wrapRect.width) left = wrapRect.width - 250;
  if(top < 5) top = 5;
  tip.style.left = left + 'px';
  tip.style.top = top + 'px';
}

function hideChartTooltip(){
  const tip = document.getElementById('equityTooltip');
  if(tip) tip.style.display = 'none';
}

function renderExitReasons(reasons, summary){
  const listEl = document.getElementById('pnlExitReasonsList');
  if(!listEl) return;
  const exitCntEl = document.getElementById('pnlExitCount');
  if(exitCntEl) exitCntEl.textContent = `${summary.total_trades || 0} EXITS RECORDED`;

  const metaMap = {
    'TAKE_PROFIT': { label: 'Take Profit (50% Milestone)', color: 'var(--lime)', desc: 'Banked gains at 3.0%+ threshold' },
    'RATCHET_VAULT': { label: 'Ratchet Vault Protection', color: 'var(--teal)', desc: 'Guaranteed floor hit before reversal' },
    'STOP_LOSS': { label: 'Micro Hard Stop Containment', color: 'var(--clay)', desc: 'Tight -1.5% to -2.0% risk containment' },
    'OTHER': { label: 'Runner Trailing Exit', color: 'var(--amber)', desc: 'Pullback from local peak on runner' }
  };

  const totalTrades = Math.max(1, summary.total_trades || 1);
  let html = '';

  for(const [k, v] of Object.entries(reasons)){
    const count = v.count || 0;
    if(count === 0) continue;
    const meta = metaMap[k] || { label: k, color: 'var(--paper2)', desc: 'Execution rule exit' };
    const pct = ((count / totalTrades) * 100).toFixed(1);
    const pnlSol = v.pnl_sol || 0.0;
    const isGain = pnlSol >= 0;
    const pnlClass = isGain ? 'green' : 'red';
    const pnlStr = (isGain ? '+' : '') + pnlSol.toFixed(6) + ' SOL';

    html += `
      <div class="exit-reason-row">
        <div class="err-top">
          <span class="err-name">${esc(meta.label)}</span>
          <span class="err-val ${pnlClass}">${pnlStr}</span>
        </div>
        <div class="err-bar-bg">
          <div class="err-bar-fill" style="width:${pct}%;background:${meta.color}"></div>
        </div>
        <div class="err-meta">
          <span>${esc(meta.desc)}</span>
          <span>${count} trades (${pct}%)</span>
        </div>
      </div>
    `;
  }

  if(!html){
    html = `<div style="color:var(--dim);text-align:center;padding:16px;font-size:11px">Awaiting exit execution telemetry...</div>`;
  }
  listEl.innerHTML = html;
}

function renderOutliers(best, worst){
  const wrap = document.getElementById('pnlOutliersWrap');
  if(!wrap) return;
  let html = '';

  if(best){
    const bestSolStr = '+' + (best.pnl_sol || 0).toFixed(6) + ' SOL';
    const bestPctStr = '+' + ((best.pnl_pct || 0) * 100).toFixed(2) + '%';
    const addr = best.address || '';
    const addrShort = addr ? (addr.slice(0, 4) + '...' + addr.slice(-4)) : '';
    html += `
      <div style="background:var(--ink2);border:1px solid #c8f24a44;border-radius:8px;padding:12px 14px">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px">
          <div style="display:flex;align-items:center;gap:6px">
            <span style="font-family:var(--mono);font-size:9.5px;font-weight:700;padding:2px 5px;background:#c8f24a20;color:var(--lime);border-radius:3px">LARGEST GAIN</span>
            <span style="font-family:var(--disp);font-weight:800;font-size:13.5px;color:var(--paper)">${esc(best.symbol)}</span>
          </div>
          <div style="text-align:right">
            <span style="font-family:var(--disp);font-weight:800;font-size:14px;color:var(--lime)">${bestSolStr}</span>
            <span style="font-family:var(--mono);font-size:10.5px;color:var(--lime);margin-left:4px">(${bestPctStr})</span>
          </div>
        </div>
        <div style="font-size:10.5px;color:var(--paper2);font-family:var(--mono);margin-bottom:4px;word-break:break-all">${esc(best.reason || 'Take profit')}</div>
        <div style="display:flex;justify-content:space-between;font-size:9.5px;color:var(--dim);font-family:var(--mono)">
          <span>Hold: ${(best.hold_minutes || 0).toFixed(1)}m | CA: ${addrShort}</span>
          <a href="https://solscan.io/token/${encodeURIComponent(addr)}" target="_blank" rel="noopener" style="color:var(--lime);text-decoration:none">Solscan ↗</a>
        </div>
      </div>
    `;
  } else {
    html += `<div style="background:var(--ink2);border:1px solid var(--line);border-radius:8px;padding:12px;font-size:11px;color:var(--dim)">No winning trades closed yet.</div>`;
  }

  if(worst){
    const worstSolStr = (worst.pnl_sol || 0).toFixed(6) + ' SOL';
    const worstPctStr = ((worst.pnl_pct || 0) * 100).toFixed(2) + '%';
    const addr = worst.address || '';
    const addrShort = addr ? (addr.slice(0, 4) + '...' + addr.slice(-4)) : '';
    html += `
      <div style="background:var(--ink2);border:1px solid #ec5a4044;border-radius:8px;padding:12px 14px">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px">
          <div style="display:flex;align-items:center;gap:6px">
            <span style="font-family:var(--mono);font-size:9.5px;font-weight:700;padding:2px 5px;background:#ec5a4020;color:var(--clay);border-radius:3px">LARGEST LOSS</span>
            <span style="font-family:var(--disp);font-weight:800;font-size:13.5px;color:var(--paper)">${esc(worst.symbol)}</span>
          </div>
          <div style="text-align:right">
            <span style="font-family:var(--disp);font-weight:800;font-size:14px;color:var(--clay)">${worstSolStr}</span>
            <span style="font-family:var(--mono);font-size:10.5px;color:var(--clay);margin-left:4px">(${worstPctStr})</span>
          </div>
        </div>
        <div style="font-size:10.5px;color:var(--paper2);font-family:var(--mono);margin-bottom:4px;word-break:break-all">${esc(worst.reason || 'Stop loss')}</div>
        <div style="display:flex;justify-content:space-between;font-size:9.5px;color:var(--dim);font-family:var(--mono)">
          <span>Hold: ${(worst.hold_minutes || 0).toFixed(1)}m | CA: ${addrShort}</span>
          <a href="https://solscan.io/token/${encodeURIComponent(addr)}" target="_blank" rel="noopener" style="color:var(--clay);text-decoration:none">Solscan ↗</a>
        </div>
      </div>
    `;
  } else {
    html += `<div style="background:var(--ink2);border:1px solid var(--line);border-radius:8px;padding:12px;font-size:11px;color:var(--dim)">No losses recorded.</div>`;
  }

  wrap.innerHTML = html;
}

/* Council Risk Tier Performance Matrix Renderer */
function renderRiskTiers(tiers, summary){
  const grid = document.getElementById('analyticsRiskTiersGrid');
  if(!grid) return;
  const avgEl = document.getElementById('analyticsAvgRating');
  if(avgEl && summary){
    const sc = summary.avg_council_score != null ? summary.avg_council_score : 65;
    avgEl.textContent = `${sc.toFixed(1)} / 100`;
    avgEl.style.color = sc >= 70 ? 'var(--lime)' : (sc >= 50 ? 'var(--amber)' : 'var(--clay)');
  }

  const defs = [
    { key: 'LOW_RISK', name: 'LOW RISK', range: 'Score 80-100', cls: 'tier-low', desc: 'Highest institutional conviction (4-5 sentinels pass)' },
    { key: 'MODERATE_RISK', name: 'MODERATE RISK', range: 'Score 60-79', cls: 'tier-mod', desc: 'Strong order flow & liquidity (3-4 sentinels pass)' },
    { key: 'ELEVATED_RISK', name: 'ELEVATED RISK', range: 'Score 40-59', cls: 'tier-elev', desc: 'Acceptable micro-momentum with elevated spread' },
    { key: 'HIGH_RISK', name: 'HIGH RISK', range: 'Score 0-39', cls: 'tier-high', desc: 'Asymmetric degen scalp / volatile runner target' },
  ];

  const totalTrades = summary ? (summary.total_trades || 1) : 1;

  let html = '';
  for(const d of defs){
    const data = (tiers && tiers[d.key]) || { trades: 0, wins: 0, pnl_sol: 0.0, win_rate_pct: 0.0 };
    const trades = data.trades || 0;
    const wins = data.wins || 0;
    const losses = Math.max(0, trades - wins);
    const wr = (data.win_rate_pct != null ? data.win_rate_pct : (trades > 0 ? (wins/trades*100) : 0)).toFixed(1);
    const pnlSol = data.pnl_sol || 0.0;
    const pnlClass = pnlSol >= 0 ? 'green' : 'red';
    const pnlStr = (pnlSol >= 0 ? '+' : '') + pnlSol.toFixed(6) + ' SOL';
    const sharePct = Math.round((trades / Math.max(1, totalTrades)) * 100);

    html += `
      <div class="pnl-tier-card ${d.cls}">
        <div class="ptc-top">
          <span class="ptc-badge ${d.cls}">${d.name}</span>
          <span class="ptc-range">${d.range}</span>
        </div>
        <div style="font-size:9.5px;color:var(--dim2);line-height:1.4">${d.desc}</div>
        <div class="ptc-metrics">
          <div class="ptc-m">
            <span class="ptc-k">TRADES / SHARE</span>
            <span class="ptc-v">${trades} <small style="color:var(--dim);font-weight:400">(${sharePct}%)</small></span>
          </div>
          <div class="ptc-m">
            <span class="ptc-k">WIN RATE</span>
            <span class="ptc-v ${wr >= 50 ? 'green' : (trades > 0 ? 'red' : '')}">${trades > 0 ? wr + '%' : '—'}</span>
          </div>
          <div class="ptc-m">
            <span class="ptc-k">WINS / LOSSES</span>
            <span class="ptc-v">${wins}W / ${losses}L</span>
          </div>
          <div class="ptc-m">
            <span class="ptc-k">NET REALIZED</span>
            <span class="ptc-v ${pnlClass}">${trades > 0 ? pnlStr : '0.000000 SOL'}</span>
          </div>
        </div>
        <div class="ptc-bar-wrap">
          <div class="ptc-bar-bg">
            <div class="ptc-bar-fill" style="width:${sharePct}%;background:var(--${d.cls === 'tier-low' ? 'lime' : d.cls === 'tier-mod' ? 'amber' : d.cls === 'tier-elev' ? 'paper' : 'clay'})"></div>
          </div>
          <div class="ptc-bar-meta">
            <span>Volume Share: ${sharePct}%</span>
            <span>Outcome: ${trades > 0 ? (pnlSol >= 0 ? 'Profitable' : 'Deficit') : 'No trades'}</span>
          </div>
        </div>
      </div>
    `;
  }

  grid.innerHTML = html;
}

function filterAnalyticsTrades(tab){
  activeAnalyticsFilter = tab;
  document.getElementById('pnlTabAll').classList.toggle('active', tab === 'ALL');
  document.getElementById('pnlTabGains').classList.toggle('active', tab === 'GAINS');
  document.getElementById('pnlTabLosses').classList.toggle('active', tab === 'LOSSES');
  document.getElementById('pnlTabActive').classList.toggle('active', tab === 'ACTIVE');
  renderAnalyticsTrades();
}

function onAnalyticsSearch(val){
  analyticsSearchQuery = (val || '').toLowerCase().trim();
  renderAnalyticsTrades();
}

function renderAnalyticsTrades(){
  const listEl = document.getElementById('pnlTradesList');
  if(!listEl || !analyticsData) return;

  let items = [];
  const d = analyticsData;

  if(activeAnalyticsFilter === 'ALL'){
    items = (d.recent_trades || []).map(t => ({ ...t, status: (t.pnl_sol >= 0 ? 'WIN' : 'LOSS') }));
  } else if(activeAnalyticsFilter === 'GAINS'){
    items = (d.winning_trades || []).map(t => ({ ...t, status: 'WIN' }));
  } else if(activeAnalyticsFilter === 'LOSSES'){
    items = (d.losing_trades || []).map(t => ({ ...t, status: 'LOSS' }));
  } else if(activeAnalyticsFilter === 'ACTIVE'){
    items = (d.active_positions || []).map(p => ({
      symbol: p.symbol,
      address: p.address,
      reason: `RUNNER RIDING (Held: ${p.cycles} cycles, Size: ${p.size_sol} SOL)`,
      percent: 100,
      entry_price: p.entry_price,
      exit_price: p.cur_price,
      pnl_pct: p.pnl,
      pnl_sol: p.pnl * (p.size_sol || 0.216),
      hold_minutes: ((p.cycles || 0) * 3.5 / 60),
      timestamp: new Date().toISOString(),
      status: 'ACTIVE'
    }));
  }

  if(analyticsSearchQuery){
    items = items.filter(t => {
      const sym = (t.symbol || '').toLowerCase();
      const addr = (t.address || '').toLowerCase();
      const reas = (t.reason || '').toLowerCase();
      return sym.includes(analyticsSearchQuery) || addr.includes(analyticsSearchQuery) || reas.includes(analyticsSearchQuery);
    });
  }

  if(items.length === 0){
    listEl.innerHTML = `<div style="color:var(--dim);text-align:center;padding:32px;font-size:12px;background:var(--ink);border:1px solid var(--line);border-radius:8px">No trades match the selected filter or query.</div>`;
    return;
  }

  let html = '';
  for(const t of items){
    const isWin = t.status === 'WIN';
    const isLoss = t.status === 'LOSS';
    const isOpen = t.status === 'ACTIVE';

    const cardClass = isWin ? 'win' : (isLoss ? 'loss' : 'open');
    const badgeClass = isWin ? 'win' : (isLoss ? 'loss' : 'open');
    const badgeText = isWin ? 'WIN' : (isLoss ? 'LOSS' : 'OPEN RUNNER');

    const pnlSol = t.pnl_sol || 0.0;
    const pnlPct = t.pnl_pct || 0.0;
    const pnlClass = pnlSol >= 0 ? 'green' : 'red';
    const pnlSolStr = (pnlSol >= 0 ? '+' : '') + pnlSol.toFixed(6) + ' SOL';
    const pnlPctStr = (pnlPct >= 0 ? '+' : '') + (pnlPct * 100).toFixed(2) + '%';

    const addr = t.address || '';
    const addrShort = addr ? (addr.slice(0, 4) + '...' + addr.slice(-4)) : '';
    const solscanUrl = addr ? `https://solscan.io/token/${encodeURIComponent(addr)}` : '#';
    const timeStr = t.timestamp ? (new Date(t.timestamp).toLocaleTimeString() || t.timestamp) : '--:--:--';
    const exitPct = t.percent ? `${t.percent}% SOLD` : '100% EXITED';

    const sc = t.council_risk_score != null ? t.council_risk_score : (t.council_score != null ? t.council_score : (isWin ? 75 : 35));
    const tier = sc >= 80 ? 'LOW' : sc >= 60 ? 'MOD' : sc >= 40 ? 'ELEV' : 'HIGH';
    const tierCls = sc >= 80 ? 'tier-low' : sc >= 60 ? 'tier-mod' : sc >= 40 ? 'tier-elev' : 'tier-high';
    const fullTier = sc >= 80 ? 'LOW_RISK' : sc >= 60 ? 'MODERATE_RISK' : sc >= 40 ? 'ELEVATED_RISK' : 'HIGH_RISK';

    html += `
      <div class="pnl-trade-item ${cardClass}">
        <div class="pti-top">
          <div class="pti-sym-wrap">
            <span class="pti-sym">${esc(t.symbol || 'TOKEN')}</span>
            <span class="pti-badge ${badgeClass}">${badgeText}</span>
            <span class="rating-badge ${tierCls}" title="Council Advisory Rating: ${sc}/100 (${fullTier})"><span class="score">${sc}</span><span class="tier">${tier}</span></span>
            <span style="font-family:var(--mono);font-size:9.5px;color:var(--dim2)">${exitPct}</span>
          </div>
          <div class="pti-pnl-wrap">
            <span class="pti-pnl-sol ${pnlClass}">${pnlSolStr}</span>
            <span class="pti-pnl-pct ${pnlClass}">(${pnlPctStr})</span>
          </div>
        </div>

        <div class="pti-metrics">
          <div class="pti-m-col">
            <span class="pti-m-lbl">ENTRY PRICE</span>
            <span class="pti-m-val">${(t.entry_price || 0).toFixed(8)}</span>
          </div>
          <div class="pti-m-col">
            <span class="pti-m-lbl">${isOpen ? 'CURRENT PRICE' : 'EXIT PRICE'}</span>
            <span class="pti-m-val">${(t.exit_price || 0).toFixed(8)}</span>
          </div>
          <div class="pti-m-col">
            <span class="pti-m-lbl">HOLD TIME</span>
            <span class="pti-m-val">${(t.hold_minutes || 0).toFixed(1)}m</span>
          </div>
          <div class="pti-m-col">
            <span class="pti-m-lbl">CONTRACT</span>
            <span class="pti-m-val"><a href="${solscanUrl}" target="_blank" rel="noopener" style="color:var(--paper2);text-decoration:none">${addrShort} ↗</a></span>
          </div>
        </div>

        <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px">
          <div class="pti-reason">${esc(t.reason || 'Executed')}</div>
          <div class="pti-time">${timeStr}</div>
        </div>
      </div>
    `;
  }

  listEl.innerHTML = html;
}

let agentTelemetryData = null;
let activeAgentFilter = 'ALL';
let agentSearchQuery = '';

async function loadBrainData(){
  try{
    const [stRes, memRes, agRes, histRes] = await Promise.all([
      fetch(API+'/api/brain/status').then(r=>r.ok?r.json():null).catch(()=>null),
      fetch(API+'/api/brain/memory').then(r=>r.ok?r.json():null).catch(()=>null),
      fetch(API+'/api/brain/agents').then(r=>r.ok?r.json():null).catch(()=>null),
      fetch(API+'/api/brain/history?limit=50').then(r=>r.ok?r.json():null).catch(()=>null)
    ]);
    if(stRes && typeof renderBrainStatus === 'function'){ renderBrainStatus(stRes); }
    if(memRes && typeof renderBrainMemory === 'function'){ renderBrainMemory(memRes); }
    if(agRes && typeof renderAgentTelemetry === 'function'){ agentTelemetryData = agRes; renderAgentTelemetry(agRes); }
    if(histRes && typeof renderHistoryView === 'function'){
      historyData = histRes.history || [];
      renderHistoryView();
    }
  }catch(e){
    console.error('Failed to load brain data', e);
  }
}

// ══════════ TRADE HISTORY CITADEL ENGINE ══════════
async function loadHistoryViewData(){
  try{
    const [analyticsRes, brainHistRes] = await Promise.all([
      fetch(API + '/api/analytics').then(r => r.ok ? r.json() : null).catch(() => null),
      fetch(API + '/api/brain/history?limit=200').then(r => r.ok ? r.json() : null).catch(() => null)
    ]);

    let trades = [];
    let summary = {};

    if(analyticsRes && analyticsRes.ok){
      summary = analyticsRes.summary || {};
      trades = analyticsRes.closed_trades || [];
    } else if(brainHistRes && brainHistRes.history){
      trades = brainHistRes.history || [];
      summary = brainHistRes.summary || {};
    }

    // Merge reflections and risk scores from brain memory if available
    if(brainHistRes && brainHistRes.history){
      const brainMap = new Map();
      brainHistRes.history.forEach(bh => {
        if(bh.symbol) brainMap.set(bh.symbol + '_' + (bh.timestamp || ''), bh);
        else if(bh.address) brainMap.set(bh.address, bh);
      });

      trades.forEach(t => {
        const key = t.symbol + '_' + (t.timestamp || '');
        const match = brainMap.get(key) || (t.address ? brainMap.get(t.address) : null);
        if(match){
          if(!t.reflection && match.reflection) t.reflection = match.reflection;
          if(t.council_risk_score == null && match.council_risk_score != null) t.council_risk_score = match.council_risk_score;
          if(!t.outcome && match.outcome) t.outcome = match.outcome;
        }
      });
    }

    // Update Hero KPI Metrics
    const realizedSol = Number(summary.net_realized_pnl_sol || 0);
    const realizedUsd = Number(summary.net_realized_pnl_usd || (realizedSol * 139.0));
    const solEl = document.getElementById('histRealizedSol');
    const usdEl = document.getElementById('histRealizedUsd');
    if(solEl){
      solEl.textContent = `${realizedSol >= 0 ? '+' : ''}${realizedSol.toFixed(4)} SOL`;
      solEl.className = `hist-kpi-val ${realizedSol >= 0 ? 'green' : 'red'}`;
    }
    if(usdEl){
      usdEl.textContent = `≈ ${realizedUsd >= 0 ? '+' : '-'}$${Math.abs(realizedUsd).toFixed(2)} USD`;
    }

    const wr = Number(summary.win_rate_pct != null ? summary.win_rate_pct : (summary.win_rate_ema ? summary.win_rate_ema * 100 : 0));
    const winCnt = Number(summary.winning_trades_count || summary.wins || 0);
    const lossCnt = Number(summary.losing_trades_count || summary.losses || 0);
    const totalCnt = Number(summary.total_trades || trades.length || 0);

    const wrEl = document.getElementById('histWinRate');
    const cntEl = document.getElementById('histClosedCount');
    if(wrEl){
      wrEl.textContent = `${wr.toFixed(1)}%`;
      wrEl.className = `hist-kpi-val ${wr >= 50 ? 'green' : (wr >= 35 ? 'amber' : 'red')}`;
    }
    if(cntEl){
      cntEl.textContent = `${winCnt} Wins / ${lossCnt} Losses (${totalCnt} Total)`;
    }

    const pf = Number(summary.profit_factor || 0);
    const grossGain = Number(summary.total_sol_gained || 0);
    const grossLoss = Number(summary.total_sol_lost || 0);
    const pfEl = document.getElementById('histProfitFactor');
    const grossEl = document.getElementById('histGrossSol');
    if(pfEl){
      pfEl.textContent = `${pf > 0 ? pf.toFixed(2) : '0.00'}x`;
      pfEl.className = `hist-kpi-val ${pf >= 1.5 ? 'green' : (pf >= 1.0 ? 'amber' : 'red')}`;
    }
    if(grossEl){
      grossEl.textContent = `Gains: +${grossGain.toFixed(4)} / Losses: -${grossLoss.toFixed(4)}`;
    }

    // Stagnation Count (trades with 0% PnL or flat exits)
    const stagTrades = trades.filter(t => {
      const p = Number(t.pnl_pct || 0);
      const r = String(t.reason || t.exit_reason || '').toUpperCase();
      return p === 0 || r.includes('STAGNATION') || r.includes('FLAT') || r.includes('HOLD_TIME_EXPIRED');
    });
    const stagEl = document.getElementById('histStagnationCount');
    if(stagEl){
      stagEl.textContent = String(stagTrades.length);
    }

    historyData = trades;
    renderHistoryView();
  }catch(e){
    console.error('Failed to load history view telemetry:', e);
  }
}

function setHistFilter(filter){
  activeHistFilter = filter;
  const tabs = {
    'ALL': document.getElementById('histFilterAll'),
    'WINS': document.getElementById('histFilterWins'),
    'LOSSES': document.getElementById('histFilterLosses'),
    'STAGNATION': document.getElementById('histFilterStag')
  };
  Object.keys(tabs).forEach(k => {
    if(tabs[k]) tabs[k].classList.toggle('active', k === filter);
  });
  renderHistoryView();
}

function onHistSearch(q){
  histSearchQuery = (q || '').trim().toLowerCase();
  renderHistoryView();
}

function renderHistoryView(){
  const listEl = document.getElementById('histTimelineList');
  if(!listEl) return;

  const trades = historyData || [];

  // Calculate live filter tab counts
  let cntAll = trades.length;
  let cntWins = 0;
  let cntLosses = 0;
  let cntStag = 0;

  trades.forEach(t => {
    const sol = Number(t.pnl_sol || 0);
    const pct = Number(t.pnl_pct || 0);
    const outcome = String(t.outcome || '').toUpperCase();
    const reason = String(t.reason || t.exit_reason || '').toUpperCase();

    const isStag = pct === 0 || sol === 0 || reason.includes('STAGNATION') || reason.includes('FLAT') || outcome === 'STAGNATION';
    const isWin = !isStag && (sol > 0 || outcome === 'WIN');
    const isLoss = !isStag && (sol < 0 || outcome === 'LOSS' || outcome === 'CONTAINED_LOSS');

    if(isWin) cntWins++;
    else if(isLoss) cntLosses++;
    if(isStag) cntStag++;
  });

  const allBadge = document.getElementById('cntHistAll');
  const winsBadge = document.getElementById('cntHistWins');
  const lossesBadge = document.getElementById('cntHistLosses');
  const stagBadge = document.getElementById('cntHistStag');
  if(allBadge) allBadge.textContent = String(cntAll);
  if(winsBadge) winsBadge.textContent = String(cntWins);
  if(lossesBadge) lossesBadge.textContent = String(cntLosses);
  if(stagBadge) stagBadge.textContent = String(cntStag);

  // Filter items
  const filtered = trades.filter(t => {
    const sol = Number(t.pnl_sol || 0);
    const pct = Number(t.pnl_pct || 0);
    const outcome = String(t.outcome || '').toUpperCase();
    const reason = String(t.reason || t.exit_reason || '').toUpperCase();

    const isStag = pct === 0 || sol === 0 || reason.includes('STAGNATION') || reason.includes('FLAT') || outcome === 'STAGNATION';
    const isWin = !isStag && (sol > 0 || outcome === 'WIN');
    const isLoss = !isStag && (sol < 0 || outcome === 'LOSS' || outcome === 'CONTAINED_LOSS');

    if(activeHistFilter === 'WINS' && !isWin) return false;
    if(activeHistFilter === 'LOSSES' && !isLoss) return false;
    if(activeHistFilter === 'STAGNATION' && !isStag) return false;

    if(histSearchQuery){
      const sym = String(t.symbol || '').toLowerCase();
      const addr = String(t.address || t.token_address || '').toLowerCase();
      const r = reason.toLowerCase();
      const ref = String(t.reflection || '').toLowerCase();
      if(!sym.includes(histSearchQuery) && !addr.includes(histSearchQuery) && !r.includes(histSearchQuery) && !ref.includes(histSearchQuery)){
        return false;
      }
    }
    return true;
  });

  if(!filtered.length){
    listEl.innerHTML = `
      <div style="background:rgba(12,14,20,0.6);border:1px dashed var(--line);border-radius:12px;padding:48px 24px;text-align:center;color:var(--dim);font-family:var(--mono)">
        <div style="font-size:14px;font-weight:700;color:var(--paper);margin-bottom:8px">NO TRANSACTIONS MATCH QUERY</div>
        <div style="font-size:11px">Filter active: [${activeHistFilter}] · Search query: "${histSearchQuery || 'NONE'}"</div>
        <div style="font-size:10px;margin-top:12px;color:var(--dim2)">Executed trades and telemetry recordings will appear here automatically.</div>
      </div>
    `;
    return;
  }

  let html = '';
  filtered.forEach(t => {
    const sol = Number(t.pnl_sol || 0);
    const pct = Number(t.pnl_pct || 0);
    const outcome = String(t.outcome || (sol > 0 ? 'WIN' : (sol < 0 ? 'LOSS' : 'STAGNATION'))).toUpperCase();
    const reason = t.reason || t.exit_reason || 'MANUAL_OR_TIMEOUT';
    const hold = Number(t.hold_minutes || 0);
    const riskScore = t.council_risk_score != null ? Number(t.council_risk_score) : null;
    const addr = t.address || t.token_address || '';
    const sym = t.symbol || 'UNKNOWN';
    const ep = Number(t.entry_price || 0);
    const xp = Number(t.exit_price || 0);
    const mcap = Number(t.market_cap || t.mcap || 0);
    const liq = Number(t.liquidity || t.liq || 0);
    const reflection = t.reflection || '';
    const tsStr = safeFormatDateTime(t.timestamp);

    const isStag = pct === 0 || sol === 0 || reason.toUpperCase().includes('STAGNATION') || outcome === 'STAGNATION';
    const isWin = !isStag && (sol > 0 || outcome === 'WIN');
    const isLoss = !isStag && !isWin;

    let pnlClass = isWin ? 'green' : (isLoss ? 'red' : 'amber');
    let cardBorder = isWin ? 'rgba(100,255,150,0.18)' : (isLoss ? 'rgba(255,77,106,0.18)' : 'rgba(245,158,11,0.18)');
    let outcomeBg = isWin ? 'rgba(100,255,150,0.12)' : (isLoss ? 'rgba(255,77,106,0.12)' : 'rgba(245,158,11,0.12)');
    let outcomeColor = isWin ? 'var(--lime)' : (isLoss ? 'var(--pink)' : 'var(--amber)');

    let riskBadge = '';
    if(riskScore != null){
      let rColor = riskScore >= 75 ? 'var(--lime)' : (riskScore >= 50 ? 'var(--amber)' : 'var(--pink)');
      let rText = riskScore >= 75 ? 'LOW RISK' : (riskScore >= 50 ? 'MODERATE RISK' : 'HIGH RISK');
      riskBadge = `<span class="hist-card-tag" style="border-color:${rColor}44;color:${rColor}">RATING: ${riskScore}/100 (${rText})</span>`;
    }

    const solscanUrl = addr ? `https://solscan.io/token/${addr}` : '#';
    const gmgnUrl = addr ? `https://gmgn.ai/sol/token/${addr}` : '#';

    html += `
      <div class="hist-card" style="border-color:${cardBorder}">
        <div class="hist-card-header">
          <div class="hist-card-left">
            <span class="hist-card-symbol">${sym}</span>
            ${addr ? `
              <span class="hist-card-addr" title="${addr}">
                ${addr.slice(0, 4)}...${addr.slice(-4)}
              </span>
              <a href="${gmgnUrl}" target="_blank" rel="noopener" class="hist-card-tag" style="text-decoration:none;border-color:rgba(100,255,150,0.3);color:var(--lime)">GMGN</a>
              <a href="${solscanUrl}" target="_blank" rel="noopener" class="hist-card-tag" style="text-decoration:none;border-color:rgba(255,255,255,0.15);color:var(--dim)">SOLSCAN</a>
            ` : ''}
            <span class="hist-card-tag" style="background:${outcomeBg};border-color:${outcomeColor}44;color:${outcomeColor}">
              ${outcome}
            </span>
            ${riskBadge}
          </div>
          <div class="hist-card-time">${tsStr}</div>
        </div>

        <div class="hist-card-body">
          <div class="hist-metric-col">
            <div class="hist-metric-label">REALIZED RETURN</div>
            <div class="hist-metric-val ${pnlClass}">${pct >= 0 ? '+' : ''}${(pct * 100).toFixed(2)}%</div>
          </div>
          <div class="hist-metric-col">
            <div class="hist-metric-label">SOL GAIN/LOSS</div>
            <div class="hist-metric-val ${pnlClass}">${sol >= 0 ? '+' : ''}${sol.toFixed(4)} SOL</div>
          </div>
          <div class="hist-metric-col">
            <div class="hist-metric-label">HOLD DURATION</div>
            <div class="hist-metric-val">${hold > 0 ? hold.toFixed(1) + ' min' : '< 1 min'}</div>
          </div>
          <div class="hist-metric-col">
            <div class="hist-metric-label">EXECUTION EXIT REASON</div>
            <div class="hist-metric-val" style="font-size:11px;color:var(--paper)">${reason}</div>
          </div>
        </div>

        <div class="hist-card-details">
          <div class="hist-detail-item">ENTRY: <span>$${ep > 0 ? ep.toFixed(8) : '0.00'}</span></div>
          <div class="hist-detail-item">EXIT: <span>$${xp > 0 ? xp.toFixed(8) : '0.00'}</span></div>
          <div class="hist-detail-item">MCAP: <span>${mcap > 0 ? '$' + Math.round(mcap).toLocaleString() : 'N/A'}</span></div>
          <div class="hist-detail-item">LIQUIDITY: <span>${liq > 0 ? '$' + Math.round(liq).toLocaleString() : 'N/A'}</span></div>
        </div>

        ${reflection ? `
          <div class="hist-reflection-strip">
            <div class="hist-reflection-label">SUPREME COUNCIL POST-FLIGHT DEBRIEF</div>
            <div class="hist-reflection-text">${reflection}</div>
          </div>
        ` : ''}
      </div>
    `;
  });

  listEl.innerHTML = html;
}

// Legacy compat stubs
function renderHistoryStrip(data){
  if(data && data.history) {
    historyData = data.history;
    renderHistoryView();
  }
}
function toggleHistory(){
  switchView('history');
}


function safeFormatTime(ts){
  if(!ts) return 'ACTIVE';
  try{
    if(typeof ts === 'number'){
      return new Date(ts < 1e11 ? ts * 1000 : ts).toLocaleTimeString();
    }
    const n = Number(ts);
    if(!isNaN(n)){
      return new Date(n < 1e11 ? n * 1000 : n).toLocaleTimeString();
    }
    const d = new Date(ts);
    return isNaN(d.getTime()) ? String(ts) : d.toLocaleTimeString();
  }catch(_){
    return String(ts);
  }
}

function safeFormatDateTime(ts){
  if(!ts) return 'N/A';
  try{
    if(typeof ts === 'number'){
      return new Date(ts < 1e11 ? ts * 1000 : ts).toLocaleString();
    }
    const n = Number(ts);
    if(!isNaN(n)){
      return new Date(n < 1e11 ? n * 1000 : n).toLocaleString();
    }
    const d = new Date(ts);
    return isNaN(d.getTime()) ? String(ts) : d.toLocaleString();
  }catch(_){
    return String(ts);
  }
}

function renderBrainStatus(data){
  if(!data) return;
  const bmText = document.getElementById('bmText');
  const bmTime = document.getElementById('bmTime');
  if(bmText && data.monologue) bmText.textContent = data.monologue;
  if(bmTime && data.timestamp) bmTime.textContent = 'LAST THOUGHT: ' + safeFormatTime(data.timestamp) + ' // STATE: ' + (data.state||'ACTIVE').toUpperCase();
  
  if(data.recent_deliberations && data.recent_deliberations.length > 0){
    renderCouncilResult(data.recent_deliberations[0]);
  }

  if(data.learned_heuristics){
    const h = data.learned_heuristics;
    const hMinScore = document.getElementById('hMinScore');
    const hMinLiq = document.getElementById('hMinLiq');
    const hMaxSlip = document.getElementById('hMaxSlip');
    const hTakeProfit = document.getElementById('hTakeProfit');
    const hVer = document.getElementById('heuristicVersion');
    if(hMinScore && h.min_quality_score != null) hMinScore.textContent = Number(h.min_quality_score).toFixed(1);
    if(hMinLiq && h.min_liquidity_usd != null) hMinLiq.textContent = '$' + Number(h.min_liquidity_usd).toLocaleString();
    if(hMaxSlip && h.max_slippage_pct != null) hMaxSlip.textContent = Number(h.max_slippage_pct).toFixed(1) + '%';
    if(hTakeProfit && h.dynamic_profit_target_pct != null) hTakeProfit.textContent = Number(h.dynamic_profit_target_pct).toFixed(1) + '%';
    if(hVer && h.version != null) hVer.textContent = 'GEN ' + h.version;
  }
}

function renderBrainMemory(data){
  if(!data) return;
  const list = document.getElementById('brainMemoryList');
  const cnt = document.getElementById('memoryCount');
  const memories = data.memories || [];
  if(cnt) cnt.textContent = memories.length + ' POST-MORTEMS';
  if(!list) return;
  if(memories.length === 0){
    list.innerHTML = '<div style="color:var(--dim);font-size:11.5px;padding:12px;text-align:center">No trade post-mortems logged yet. Completed trades will populate here with auto-learning reflections.</div>';
    return;
  }
  let html = '';
  const rev = [...memories].reverse();
  for(const m of rev.slice(0, 30)){
    const isWin = (m.pnl_pct || 0) >= 0;
    const pnlSign = isWin ? '+' : '';
    const pnlClass = isWin ? 'win' : 'loss';
    const tsStr = safeFormatDateTime(m.timestamp);
    html += '<div class="memory-entry">' +
      '<div class="me-top">' +
        '<span class="me-sym">' + (typeof esc === 'function' ? esc(m.symbol || 'UNKNOWN') : (m.symbol||'UNKNOWN')) + ' <span style="font-size:10px;color:var(--dim)">(' + (typeof esc === 'function' ? esc(m.chain || 'N/A') : (m.chain||'N/A')) + ')</span></span>' +
        '<span class="me-pnl ' + pnlClass + '">' + pnlSign + Number(m.pnl_pct || 0).toFixed(2) + '% ($' + Number(m.pnl_usd || 0).toFixed(2) + ')</span>' +
      '</div>' +
      '<div class="me-refl">' + (typeof esc === 'function' ? esc(m.reflection || 'No reflection recorded.') : (m.reflection||'')) + '</div>' +
      '<div class="me-time">EXIT: ' + (typeof esc === 'function' ? esc(m.exit_reason || 'MANUAL') : (m.exit_reason||'MANUAL')) + ' // ' + tsStr + '</div>' +
    '</div>';
  }
  list.innerHTML = html;
}

async function evalCouncil(){
  const sym = (document.getElementById('evalSym').value || 'KIDA').trim().toUpperCase();
  const score = parseFloat(document.getElementById('evalScore').value || '85');
  const liq = parseFloat(document.getElementById('evalLiq').value || '90000');
  const vBox = document.getElementById('councilVerdictBox');
  const dList = document.getElementById('councilDebateList');

  if(vBox){
    vBox.style.display = 'block';
    vBox.innerHTML = '<div style="font-size:12px;color:var(--lime);padding:8px 0">Convening 23-Subagent Supreme Council deliberation...</div>';
  }

  try{
    const res = await fetch(API+'/api/council/evaluate', {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({
        symbol: sym,
        score: score,
        liquidity_usd: liq,
        chain: curChain || 'sol',
        address: 'DEMO_OR_LIVE_ADDR'
      })
    });
    if(!res.ok){
      if(vBox) vBox.innerHTML = '<div style="color:var(--clay);font-size:12px">Council deliberation failed with HTTP ' + res.status + '</div>';
      return;
    }
    const data = await res.json();
    renderCouncilResult(data);
    loadBrainData();
  }catch(e){
    if(vBox) vBox.innerHTML = '<div style="color:var(--clay);font-size:12px">Failed to communicate with Council API: ' + (typeof esc === 'function' ? esc(e.message) : e.message) + '</div>';
  }
}

function renderCouncilResult(data){
  const vBox = document.getElementById('councilVerdictBox');
  const dList = document.getElementById('councilDebateList');
  if(!data) return;

  const app = !!data.approved;
  const vColor = app ? 'var(--lime)' : 'var(--clay)';
  const vBg = app ? '#c8f24a15' : '#ec5a4015';
  const vBorder = app ? '#c8f24a40' : '#ec5a4040';
  const symStr = data.symbol ? ' (' + (typeof esc === 'function' ? esc(data.symbol) : data.symbol) + ')' : '';
  const tsStr = safeFormatTime(data.timestamp);

  if(vBox){
    vBox.style.display = 'block';
    vBox.innerHTML = '<div style="background:' + vBg + ';border:1px solid ' + vBorder + ';border-radius:8px;padding:12px 14px">' +
      '<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px">' +
        '<span style="font-family:var(--disp);font-weight:800;font-size:13.5px;color:' + vColor + '">VERDICT: ' + (typeof esc === 'function' ? esc(data.verdict || (app?'APPROVED':'REJECTED')) : (data.verdict||'')) + symStr + '</span>' +
        '<span style="font-family:var(--disp);font-weight:700;font-size:12.5px;color:' + vColor + '">SCORE: ' + Number(data.score||(data.consensus_score!=null?data.consensus_score/10.0:0)).toFixed(1) + '/10</span>' +
      '</div>' +
      '<div style="font-size:12px;color:var(--paper);line-height:1.5">' + (typeof esc === 'function' ? esc(data.judge_synthesis || data.verdict_rationale || 'Deliberation concluded.') : (data.judge_synthesis||'')) + '</div>' +
      '<div style="font-size:9.5px;color:var(--dim);margin-top:6px;text-align:right">EVALUATED AT: ' + tsStr + '</div>' +
    '</div>';
  }

  if(dList && data.debates){
    let dHtml = '';
    for(const d of data.debates){
      const pass = d.verdict === 'PASS';
      const badgeCls = pass ? 'pass' : 'fail';
      dHtml += '<div class="council-debate-item">' +
        '<div class="cd-header">' +
          '<span class="cd-name">' + (typeof esc === 'function' ? esc(d.agent || 'Sentinel') : (d.agent||'')) + '</span>' +
          '<span class="cd-badge ' + badgeCls + '">' + (typeof esc === 'function' ? esc(d.verdict || 'PASS') : (d.verdict||'')) + ' (' + Number(d.score||0).toFixed(1) + '/10)</span>' +
        '</div>' +
        '<div class="cd-desc">' + (typeof esc === 'function' ? esc(d.argument || '') : (d.argument||'')) + '</div>' +
      '</div>';
    }
    dList.innerHTML = dHtml;
  }
}

function renderAgentTelemetry(data){
  if(!data || !data.memory_pool) return;
  const pool = data.memory_pool;
  const agents = data.agents || [];

  const pUtil = document.getElementById('poolUtilPct');
  const pAlloc = document.getElementById('poolAllocMb');
  const pFree = document.getElementById('poolFreeMb');
  const pFill = document.getElementById('poolBarFill');
  const pBadge = document.getElementById('fleetHealthBadge');

  const kpiAgents = document.getElementById('kpiTotalAgents');
  const kpiEvals = document.getElementById('kpiTotalEvals');
  const kpiCache = document.getElementById('kpiCacheEntries');
  const kpiLat = document.getElementById('kpiAvgLatency');

  if(pUtil) pUtil.textContent = Number(pool.utilization_pct || 0).toFixed(1) + '%';
  if(pAlloc) pAlloc.textContent = Number(pool.total_allocated_mb || 0).toFixed(2) + ' MB';
  if(pFree) pFree.textContent = Number(pool.free_memory_mb || 0).toFixed(2) + ' MB';
  if(pFill) pFill.style.width = Math.min(100, Math.max(0, pool.utilization_pct || 0)) + '%';
  if(pBadge){
    pBadge.textContent = agents.length + '/' + agents.length + ' FLEET ONLINE · ' + (pool.health_status || 'NOMINAL');
    pBadge.className = 'cd-badge ' + (pool.health_status === 'NOMINAL' ? 'pass' : 'fail');
  }

  let totalEvals = 0;
  let totalLat = 0;
  for(const a of agents){
    totalEvals += (a.evaluations || 0);
    totalLat += (a.avg_latency_ms || 0);
  }
  const avgLat = agents.length > 0 ? (totalLat / agents.length).toFixed(1) : '1.0';

  if(kpiAgents) kpiAgents.textContent = agents.length + ' ONLINE';
  if(kpiEvals) kpiEvals.textContent = totalEvals + ' CHECKS';
  if(kpiCache) kpiCache.textContent = (pool.total_cache_entries || 0) + ' NODES';
  if(kpiLat) kpiLat.textContent = avgLat + ' ms';

  renderAgentCards();
}

function filterAgentCards(tier){
  activeAgentFilter = tier;
  const tabs = document.querySelectorAll('.agent-tabs .atab');
  tabs.forEach(t => {
    t.classList.toggle('active', t.getAttribute('data-filter') === tier);
  });
  renderAgentCards();
}

function onAgentSearch(val){
  agentSearchQuery = (val || '').toLowerCase().trim();
  renderAgentCards();
}

function renderAgentCards(){
  const grid = document.getElementById('agentCardsGrid');
  if(!grid || !agentTelemetryData) return;
  const agents = agentTelemetryData.agents || [];
  
  let filtered = agents;
  if(activeAgentFilter !== 'ALL'){
    filtered = filtered.filter(a => a.category === activeAgentFilter);
  }
  if(agentSearchQuery){
    filtered = filtered.filter(a => 
      (a.name && a.name.toLowerCase().includes(agentSearchQuery)) ||
      (a.title && a.title.toLowerCase().includes(agentSearchQuery)) ||
      (a.gate && a.gate.toLowerCase().includes(agentSearchQuery)) ||
      (a.role && a.role.toLowerCase().includes(agentSearchQuery))
    );
  }

  if(filtered.length === 0){
    grid.innerHTML = '<div style="grid-column:1/-1;color:var(--dim);text-align:center;padding:24px;font-size:12px;background:var(--ink2);border:1px solid var(--line);border-radius:8px">No subagents match the selected filter.</div>';
    return;
  }

  let html = '';
  for(const a of filtered){
    const passRate = a.pass_rate != null ? Number(a.pass_rate).toFixed(1) + '%' : '100%';
    const memKb = a.memory_kb != null ? Number(a.memory_kb).toLocaleString() : '1,024';
    const memPct = a.memory_pct != null ? Number(a.memory_pct).toFixed(2) : '1.56';
    const barWidth = Math.min(100, Math.max(5, (a.memory_kb / 4096.0) * 100)).toFixed(1);

    html += '<div class="agent-card">' +
      '<div>' +
        '<div class="ac-head">' +
          '<div>' +
            '<div class="ac-title">' + (typeof esc === 'function' ? esc(a.name) : a.name) + '</div>' +
            '<div class="ac-sub">' + (typeof esc === 'function' ? esc(a.title) : a.title) + '</div>' +
          '</div>' +
          '<div class="ac-badges">' +
            '<span class="ac-gate-badge">' + (typeof esc === 'function' ? esc(a.gate || 'GATE') : a.gate) + '</span>' +
            '<span class="cd-badge pass">ONLINE</span>' +
          '</div>' +
        '</div>' +
        '<div class="ac-role">' + (typeof esc === 'function' ? esc(a.role || '') : a.role) + '</div>' +
        '<div class="ac-stats-grid">' +
          '<div class="ac-stat-item"><span class="ac-stat-k">EVALS</span><span class="ac-stat-v">' + (a.evaluations || 0) + '</span></div>' +
          '<div class="ac-stat-item"><span class="ac-stat-k">PASS/VETO</span><span class="ac-stat-v">' + (a.passes || 0) + '/' + (a.vetoes || 0) + '</span></div>' +
          '<div class="ac-stat-item"><span class="ac-stat-k">PASS RATE</span><span class="ac-stat-v" style="color:var(--lime)">' + passRate + '</span></div>' +
          '<div class="ac-stat-item"><span class="ac-stat-k">LATENCY</span><span class="ac-stat-v">' + Number(a.avg_latency_ms || 1.0).toFixed(1) + 'ms</span></div>' +
        '</div>' +
        '<div class="ac-mem-sec">' +
          '<div class="ac-mem-row">' +
            '<span class="ac-mem-lbl">WORKING MEMORY (BRAIN POOL)</span>' +
            '<span class="ac-mem-val">' + memKb + ' KB (' + memPct + '%)</span>' +
          '</div>' +
          '<div class="ac-mem-bar-bg">' +
            '<div class="ac-mem-bar-fill" style="width:' + barWidth + '%"></div>' +
          '</div>' +
        '</div>' +
      '</div>' +
      '<div class="ac-action" title="' + (typeof esc === 'function' ? esc(a.last_action || '') : (a.last_action||'')) + '">' +
        'LAST: ' + (typeof esc === 'function' ? esc(a.last_action || 'Monitoring execution pipeline') : a.last_action) +
      '</div>' +
    '</div>';
  }

  grid.innerHTML = html;
}

async function runWallet(){
  const addr=(document.getElementById('wltAddr').value||'').trim();
  const res=document.getElementById('wltResult');
  if(!addr){toast(WLK[lang].need_addr,'err');return;}
  if(addr===DEMO_WALLET_ADDR){toast(WLK[lang].need_real_addr,'err');return;}
  // 地址格式跟当前链对不上就顺手切过去，别硬查报错——EVM 三链地址格式相同分不出具体是哪条，
  // 只处理「sol ⇄ evm」这一档；已经在某条 evm 链上时保持不变，交易者自己用顶部 CHAIN 菜单挑 bsc/base/eth。
  const det=detectAddrChain(addr);
  if(det==='sol'&&curChain!=='sol')switchChain('sol');
  else if(det==='evm'&&curChain==='sol')switchChain('bsc');
  if(wltBusy)return;wltBusy=true;
  const go=document.getElementById('wltGo');go.disabled=true;
  try{
    if(source!=='backend'){
      // Probe local backend first; if reachable auto-switch, otherwise show friendly offline message
      let st=null;
      try{
        const sc=new AbortController();
        const st_timer=setTimeout(()=>sc.abort(),5000);
        const sr=await fetch(API+'/api/status',{signal:sc.signal});
        clearTimeout(st_timer);
        if(sr.ok)st=await sr.json();
      }catch(_){}
      if(!st){res.innerHTML='<div class="wlt-err">'+WLK[lang].off+'</div>';return;}
      beReady=!!st.has_key;
      setSource('backend');                       // triggers resetWalletView() — restore address below
      document.getElementById('wltAddr').value=addr;
      if(!beReady){res.innerHTML='<div class="wlt-err">'+WLK[lang].need_key+'</div>';return;}
    }
    res.innerHTML='<div class="wlt-empty"><span class="spin"></span>'+WLK[lang].loading+'</div>';
    const body={chain:curChain,address:addr,latency_s:3,slippage_pct:0.05,gas_usd:0.2};
    const ac=new AbortController();
    const t=setTimeout(()=>ac.abort(),25000);
    let r;
    try{
      r=await fetch(API+'/api/wallet',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body),signal:ac.signal});
    }finally{clearTimeout(t);}
    if(!r.ok){let e={};try{e=await r.json();}catch(_){}
      throw new Error(e.detail||('HTTP '+r.status));}
    wltData=await r.json();renderWallet();
  }catch(e){
    // Match all browser variants of a network-level failure:
    // Chrome: "Failed to fetch", Firefox: "NetworkError when attempting to fetch resource", Safari: "Load failed", AbortError: timeout
    const msg_lc=(e.message||'').toLowerCase();
    const is_net=e.name==='AbortError'||msg_lc.includes('failed to fetch')||msg_lc.includes('networkerror')||msg_lc.includes('load failed')||msg_lc.includes('network request failed');
    const msg=is_net?WLK[lang].off:(WLK[lang].fail+': '+(e.message||'unknown error'));
    res.innerHTML='<div class="wlt-err">'+msg+'</div>';wltData=null;
  }finally{wltBusy=false;go.disabled=false;}
}

/* 格式化 */
function fmtUsd(v){v=+v||0;const s=v>=0?'+':'−';const a=Math.abs(v);let n;
  if(a>=1e6)n='$'+(a/1e6).toFixed(2)+'M';else if(a>=1e3)n='$'+(a/1e3).toFixed(1)+'K';else n='$'+a.toFixed(0);return s+n;}
function fmtK(v){v=+v||0;if(v>=1e6)return (v/1e6).toFixed(1)+'M';if(v>=1e3)return (v/1e3).toFixed(2)+'K';return ''+v;}
function pctS(v){return (v>=0?'+':'')+(v*100).toFixed(1)+'%';}
function fmtDur(s){s=+s||0;const W=WLK[lang];
  if(s<60)return Math.round(s)+W.u_sec;if(s<3600)return Math.round(s/60)+W.u_min;
  if(s<86400)return (s/3600).toFixed(1)+W.u_hr;return (s/86400).toFixed(1)+W.u_day;}
function scoreCol(s){return s>=60?'var(--lime)':s>=40?'var(--amber)':'var(--clay)';}
function esc(x){return String(x==null?'':x).replace(/[<>&]/g,c=>({'<':'&lt;','>':'&gt;','&':'&amp;'}[c]));}
// 后端 _security_unsafe() 只返回固定的几个中文短语（不是自然语言句子），用一张小表直接映射成英文，
// 不用改后端接口结构。选币侧 devSecRisks 和钱包侧 sec_risks 是同一份数据，两边共用这张表。
const RISK_LABEL_EN={'蜜罐':'Honeypot','可增发':'Mintable','未弃冻结权':'Freeze not renounced',
  '貔貅·卖不出':'Honeypot (can\'t sell)','未开源':'Not verified'};
function riskLabel(s){return lang==='en'?(RISK_LABEL_EN[s]||s):s;}

let facMode='copy';
function setFac(m){facMode=m;const box=document.getElementById('wfBox');if(box&&wltData)box.innerHTML=facRows();
  document.getElementById('facTrk').classList.toggle('on',m==='track');
  document.getElementById('facCpy').classList.toggle('on',m==='copy');
  const fd=document.getElementById('facDev');if(fd)fd.classList.toggle('on',m==='dev');}
function facRows(){
  if(facMode==='dev')return devFacRows();
  const src=facMode==='track'?wltData.track:wltData.copy;
  if(wltData.no_trades)return `<div class="wf-row"><div class="wf-note">${WLK[lang].bt_no_trades}</div></div>`;
  // 自产自销提示只在分数卡片那边统一露出一次（见 renderWallet），这里不重复
  return src.factors.map(f=>{const c=scoreCol(f.score);
    const nm=(lang==='en'&&f.name_en)?f.name_en:f.name, nt=(lang==='en'&&f.note_en)?f.note_en:f.note;
    return `<div class="wf-row"><div class="wf-head"><b>${esc(nm)}</b><span class="sc" style="color:${c}">${f.score}</span></div>
      <div class="wf-bar"><i style="width:${Math.max(3,f.score)}%;background:${c}"></i></div>
      ${nt?`<div class="wf-note">${esc(nt)}</div>`:''}</div>`;}).join('');
}
function devFacRows(){
  // 排版顺序按「有多少真正起飞(迁移率，含规模明细) → 起飞的还活着吗(存活/rug) → 可疑行为模式」的
  // 阅读逻辑走。迁移率=launches/(launches+inner_count)=launches/历史发币，跟「历史发币」「内盘沉底」
  // 是同一份数据的三个角度（历史发币=launches+inner_count），所以合并成一行：迁移率做主数值+进度条，
  // 历史发币/内盘沉底的原始计数放进这行的小字说明里，不再各占一行。
  // 后端字段名叫 survival_rate 但语义其实是「毕业率」，跟下面「存活率」是两回事——存活率/rug率是对
  // 最近取样(≤100条)里已经沉底/rug 的比例，两者容易被误当同一个指标，拆开单独展示。
  const W=WLK[lang],dv=wltData.dev;
  if(!dv)return `<div class="wf-row"><div class="wf-note">${esc(W.dev_none_s)}</div></div>`;
  const st=wltData.stats;
  const total=st.created_token_count||dv.launches||dv.analyzed||0;
  const inner=dv.inner_count||0;
  const migrate=Math.round((dv.survival_rate||0)*100);
  const surv=Math.round((dv.rug_rate!=null?(1-dv.rug_rate):0)*100);
  const rug=Math.round((dv.rug_rate||0)*100);
  const reskin=(dv.own_img_reuse||0)>=2,risks=(dv.sec_risks||[]);
  const row=(name,val,col,pct,note)=>`<div class="wf-row"><div class="wf-head"><b>${esc(name)}</b><span class="sc" style="color:${col}">${val}</span></div>
    ${pct!=null?`<div class="wf-bar"><i style="width:${Math.max(3,pct)}%;background:${col}"></i></div>`:''}
    ${note?`<div class="wf-note">${esc(note)}</div>`:''}</div>`;
  const survRugRow=`<div class="wf-row"><div class="wf-head"><b>${esc(W.dev_surv)} / ${esc(W.dev_rug)}</b>
    <span class="sc"><span style="color:var(--lime)">${surv}%</span> / <span style="color:var(--clay)">${rug}%</span></span></div>
    <div class="wh-distbar"><span style="width:${Math.max(surv,0)}%;background:var(--lime)"></span><span style="width:${Math.max(rug,0)}%;background:var(--clay)"></span></div>
    <div class="wf-note">${esc(W.dev_survrug_note)}</div></div>`;
  return [
    row(W.dev_migrate,migrate+'%',migrate>=30?'var(--lime)':migrate>=5?'var(--amber)':'var(--clay)',migrate,W.dev_migrate_detail(total,inner)),
    survRugRow,
    row(W.dev_reskin,reskin?W.yes:W.no,reskin?'var(--clay)':'var(--lime)',null,W.dev_reskin_note),
    row(W.dev_sec,risks.length?esc(risks.map(riskLabel).join('·')):W.none,risks.length?'var(--clay)':'var(--lime)',null),
  ].join('');
}

/* 跟单回测：客户端镜像后端公式，滑块即时重算 */
function btCompute(lat,slip,gas){
  const st=wltData.stats,ac=wltData.activity;
  let wpct=st.bought_cost>0?st.realized_profit/st.bought_cost:st.roi;wpct=wpct||0.0001;
  wpct=Math.max(-0.9,Math.min(3.0,wpct));   // 与后端一致：dev 钱包 bought_cost 极小→钳制，避免爆表
  const dps=0.015*(0.3+0.7*ac.entry_under_100k);
  const drift=lat*dps,slp=2*slip,gpct=st.avg_buy_usd>0?gas/st.avg_buy_usd:0;
  const cpct=wpct-drift-slp-gpct,w7=st.realized_profit,c7=wpct?w7*(cpct/wpct):0;
  return {wpct,cpct,w7,c7,trap:w7-c7};
}
function btUpdate(){
  const lat=+document.getElementById('btLat').value, slip=+document.getElementById('btSlip').value/100, gas=+document.getElementById('btGas').value;
  document.getElementById('btLatV').textContent=lat+WLK[lang].u_sec;
  document.getElementById('btSlipV').textContent=(slip*100).toFixed(0)+' %';
  document.getElementById('btGasV').textContent=gas.toFixed(2)+' $';
  document.getElementById('btRes').innerHTML=btResHtml(btCompute(lat,slip,gas));
}
function btResHtml(b){
  const W=WLK[lang];const mx=Math.max(Math.abs(b.w7),Math.abs(b.c7),1);
  const bar=(v)=>{const pos=v>=0;const col=pos?'var(--lime)':'var(--clay)';
    return `<div class="wbt-barrow"><div class="wbt-mbar"><i style="width:${Math.max(4,Math.abs(v)/mx*100)}%;background:${col}"></i></div><em style="color:${col}">${fmtUsd(v)}</em></div>`;};
  return `<div class="wbt-net">${W.bt_net}　${W.bt_wallet} <b style="color:var(--lime)">${pctS(b.wpct)}</b>　${W.bt_copy} <b style="color:${b.cpct>=0?'var(--lime)':'var(--clay)'}">${pctS(b.cpct)}</b></div>
    <div class="wbt-cmp"><div class="lbl">${W.bt_w7}</div>${bar(b.w7)}</div>
    <div class="wbt-cmp"><div class="lbl">${W.bt_c7}</div>${bar(b.c7)}</div>
    <div class="wbt-trap"><span class="k">${W.bt_trap}</span><span class="v">${fmtUsd(b.trap)}</span></div>`;
}

function renderWallet(){
  const d=wltData,W=WLK[lang],st=d.stats,ac=d.activity;
  const noTrades=!!d.no_trades;
  const nm=st.name||(d.address.slice(0,6)+'…'+d.address.slice(-4));
  const days=st.created_at>0?Math.round((Date.now()/1000-st.created_at)/86400):0;
  const dist=st.dist,tn=Math.max(1,st.token_num);
  const segs=[['gt_5','#c8f24a'],['x2_5','#a6cf3f'],['x0_2','#7e992a'],['n50_0','#6b5f3a'],['lt_n50','#ec5a40']];
  const distBar=segs.map(([k,c])=>`<span style="width:${dist[k]/tn*100}%;background:${c}"></span>`).join('');
  const tagName=t=>(lang==='en'&&t.name_en)?t.name_en:t.name, tagDesc=t=>(lang==='en'&&t.desc_en)?t.desc_en:t.desc;
  const play=d.tags.slice(0,2).map(t=>esc(tagName(t))).join(' · ')||'—';
  const ts=d.track.score,cs=d.copy.score;
  const bt=d.backtest;
  const stat=(k,v,col)=>`<div class="wh-stat"><div class="k">${k}</div><div class="v"${col?` style="color:${col}"`:''}>${v}</div></div>`;

  // Dev 信誉块（第三个维度）：这里只放 分数+一句话，样式对齐真实战绩分/可跟单分；
  // 存活率/rug率/历史发币/内盘沉底/换皮重发/安全风险 挪到下面「DEV 信誉·因子」tab（见 devFacRows）。
  // base 链 gmgn-cli 的 created_token_count 回填不全（已验证：确认发过币的钱包仍读到 0），
  // 门槛判断会漏判发币方，暂时整块不展示，避免误导用户「这个地址没发过币」。
  let devHtml='';
  if(d.chain==='base'){
    // 不渲染；facMode 若停在 'dev' 也退回 copy，避免 base 下 toggle 按钮消失但内容仍是 dev 空态
    if(facMode==='dev')facMode='copy';
  }else if(d.dev){const dv=d.dev,ds=Math.round((dv.score||0)*100);
    devHtml=`
    <div class="wlt-card">
      <div class="ws-lbl">${W.dev}</div>
      <div class="ws-num" style="color:${scoreCol(ds)}">${ds}<i>/100</i></div>
      <div class="ws-track"><i style="width:${ds}%;background:${scoreCol(ds)}"></i></div>
      <div class="ws-sub">${W.dev_sub}</div>
    </div>`;
  }else{
    devHtml=`
    <div class="wlt-card">
      <div class="ws-lbl">${W.dev}</div>
      <div class="ws-num" style="color:var(--dim)">—</div>
      <div class="ws-sub">${W.dev_none_t}</div>
    </div>`;
  }

  let html=`
  <div class="wlt-card">
    <div class="wh-top">
      <div>
        <div class="wh-id"><span class="wh-name">${esc(nm)}</span><span class="wh-chain">${(d.chain||'').toUpperCase()}</span>
          <span class="wh-meta">${d.address.slice(0,6)}…${d.address.slice(-4)} · ${W.active(days)}${st.twitter_fans>0?` · ${W.fans} ${fmtK(st.twitter_fans)}`:''}${st.is_verified?' ✔':''}</span></div>
        <div class="wh-meta" style="margin-top:9px">${W.play}：<b style="color:var(--paper2)">${play}</b></div>
      </div>
      <div class="wh-pnl" style="color:${st.realized_profit>=0?'var(--lime)':'var(--clay)'}">${fmtUsd(st.realized_profit)}<span class="roi">ROI ${pctS(st.roi)}</span></div>
    </div>
    <div class="wh-tags">${d.tags.map(t=>`<span class="wh-tag"><span class="em">${t.emoji||'#'}</span><b>${esc(tagName(t))}</b><i>${esc(tagDesc(t))}</i></span>`).join('')}</div>
    <div class="wh-stats">
      ${stat(W.s_pnl,fmtUsd(st.realized_profit),st.realized_profit>=0?'var(--lime)':'var(--clay)')}
      ${stat(W.s_win,(st.winrate*100).toFixed(2)+'%')}
      ${stat(W.s_hold,fmtDur(st.avg_hold_s))}
      ${stat(W.s_trades,st.buy+'/'+st.sell)}
      ${stat(W.s_avg,fmtUsd(st.avg_trade_usd))}
      ${stat(W.s_early,(ac.entry_under_100k*100).toFixed(1)+'%',ac.entry_under_100k>0.7?'var(--amber)':'')}
      ${stat(W.s_flip,(ac.fast_flip_rate*100).toFixed(1)+'%',ac.fast_flip_rate>0.3?'var(--amber)':'')}
    </div>
    <div class="wh-dist">
      ${noTrades
        ?`<div class="wh-distleg">${esc(W.no_trades_note(st.token_num))}</div>`
        :`<div class="wh-distbar">${distBar}</div>
      <div class="wh-distleg">${W.dist} <b>${st.token_num} ${W.coins}</b>：>500% ${dist.gt_5} · 200–500% ${dist.x2_5} · 0–200% ${dist.x0_2} · −50–0% ${dist.n50_0} · <−50% ${dist.lt_n50}</div>`}
    </div>
  </div>

  <div class="wlt-scores-block">
    <div class="wlt-scores"${d.chain==='base'?' style="grid-template-columns:1fr 1fr"':''}>
      <div class="wlt-card">
        <div class="ws-lbl">${W.trk}</div>
        <div class="ws-num" style="color:${noTrades?'var(--dim)':scoreCol(ts)}">${noTrades?'—':ts+'<i>/100</i>'}</div>
        ${noTrades?'':`<div class="ws-track"><i style="width:${ts}%;background:${scoreCol(ts)}"></i></div>`}
        <div class="ws-sub">${W.trk_sub}</div>
      </div>
      <div class="wlt-card">
        <div class="ws-lbl">${W.cpy}</div>
        <div class="ws-num" style="color:${noTrades?'var(--dim)':scoreCol(cs)}">${noTrades?'—':cs+'<i>/100</i>'}</div>
        ${noTrades?'':`<div class="ws-track"><i style="width:${cs}%;background:${scoreCol(cs)}"></i></div>`}
        <div class="ws-sub">${W.cpy_sub}</div>
      </div>
      ${devHtml}
    </div>
    ${(d.track.self_dealing||d.copy.self_dealing)?`<div class="wlt-selfdeal">${W.self_deal_note}</div>`:''}
  </div>

  <div class="wlt-card">
    <div class="ws-toggle">
      <button id="facTrk" class="trk${facMode==='track'?' on':''}" onclick="setFac('track')">${W.trk_fac}</button>
      <button id="facCpy" class="cpy${facMode==='copy'?' on':''}" onclick="setFac('copy')">${W.cpy_fac}</button>
      ${d.chain==='base'?'':`<button id="facDev" class="dev${facMode==='dev'?' on':''}" onclick="setFac('dev')">${W.dev_fac}</button>`}
    </div>
    <div id="wfBox">${facRows()}</div>
  </div>

  <div class="wlt-card">
    <h4>${W.bt}</h4>
    ${!bt?`<div class="wf-note">${W.bt_no_trades}</div>`:`
    <div class="wbt-formula">${W.bt_formula}</div>
    <div class="wbt">
      <div class="wbt-form">
        <div class="wbt-sl"><label>${W.bt_lat} <b id="btLatV">${bt.latency_s}${W.u_sec}</b></label><input type="range" id="btLat" min="0" max="10" step="1" value="${bt.latency_s}" oninput="btUpdate()"></div>
        <div class="wbt-sl"><label>${W.bt_slip} <b id="btSlipV">${(bt.slippage_pct*100).toFixed(0)} %</b></label><input type="range" id="btSlip" min="0" max="15" step="1" value="${bt.slippage_pct*100}" oninput="btUpdate()"></div>
        <div class="wbt-sl"><label>${W.bt_gas} <b id="btGasV">${bt.gas_usd.toFixed(2)} $</b></label><input type="range" id="btGas" min="0" max="2" step="0.05" value="${bt.gas_usd}" oninput="btUpdate()"></div>
      </div>
      <div class="wbt-res" id="btRes">${btResHtml({wpct:bt.wallet_pct,cpct:bt.copy_pct,w7:bt.wallet_7d,c7:bt.copy_7d,trap:bt.trap})}</div>
    </div>`}
  </div>`;

  if (d.giga) {
    const g = d.giga;
    const fg = g.four_gates || {};
    const gates = [
      { name: 'Authenticity', data: fg.authenticity || { status: 'Passed', detail: '' } },
      { name: 'Currency', data: fg.currency || { status: 'Passed', detail: '' } },
      { name: 'Reachability', data: fg.reachability || { status: 'Failed', detail: '' } },
      { name: 'Survivability', data: fg.survivability || { status: 'Passed', detail: '' } },
    ];
    const gatesHtml = gates.map(gate => {
      const isPass = (gate.data.status || '').toLowerCase() === 'passed';
      return `
      <div class="giga-gate-card ${isPass ? 'passed' : 'failed'}">
        <div class="giga-gate-head">
          <span class="giga-gate-name">${gate.name}</span>
          <span class="giga-gate-status ${isPass ? 'pass' : 'fail'}">${(gate.data.status || '').toUpperCase()}</span>
        </div>
        <div class="giga-gate-desc">${esc(gate.data.detail || '')}</div>
      </div>`;
    }).join('');

    const sty = g.style || {};
    const rf = g.risk_flags || {};
    const refutations = (rf.refutations || []).join(', ');

    const act = g.current_activity_24h || {};
    const recentBuys = (act.recent_buys || []).map(b => `${esc(b.sym)} ($${fmtK(b.usd)})`).join(' · ');

    const ob = g.open_book || {};
    const obRows = (ob.positions || []).map(p => `
      <tr>
        <td><b>${esc(p.sym)}</b></td>
        <td>$${p.val_usd.toFixed(2)}</td>
        <td>$${fmtK(p.cost_basis_usd)}</td>
        <td>${p.sell_count}</td>
        <td style="color:#4ade80">Verified Safe</td>
      </tr>
    `).join('');

    html += `
    <div class="giga-wrap">
      <div class="giga-advisory-box">
        <div class="giga-advisory-badge">GIGA BETA AUDIT</div>
        <div class="giga-advisory-text">
          <b>${esc(g.advisory || 'Watch, Do Not Copy')}</b>: ${esc(sty.implication || '')}
        </div>
      </div>

      <div class="wlt-card">
        <h4 style="margin:0 0 10px 0;font-size:12px;font-family:var(--mono);color:var(--paper1);letter-spacing:0.05em">THE FOUR GATES EVALUATION</h4>
        <div class="giga-gates-grid">${gatesHtml}</div>
      </div>

      <div class="giga-style-card">
        <div>
          <div style="font-size:10px;color:rgba(255,255,255,0.4);font-family:var(--mono)">EXECUTION STYLE</div>
          <div style="font-size:13px;font-weight:700;color:var(--lime);margin-top:2px">${esc(sty.name || 'Worn-down')} · ${esc(sty.classification || 'L4xP3')}</div>
          <div style="font-size:11px;color:rgba(255,255,255,0.6);margin-top:4px">Cadence: ~${(sty.cadence_trades_per_day||8021).toLocaleString()} trades/day</div>
        </div>
        <div>
          <div style="font-size:10px;color:rgba(255,255,255,0.4);font-family:var(--mono)">POSITION SIZING & EXIT</div>
          <div style="font-size:12px;color:var(--paper2);margin-top:2px">${esc(sty.concentration || 'Concentrated bets')}</div>
          <div style="font-size:11px;color:rgba(255,255,255,0.6);margin-top:4px">${esc(sty.exit_pattern || '')}</div>
        </div>
        <div>
          <div style="font-size:10px;color:rgba(255,255,255,0.4);font-family:var(--mono)">HONEYPOT & RISK CHECK</div>
          <div style="font-size:12px;color:#4ade80;margin-top:2px">0 Honeypots in ${rf.honeypots_checked || 50} positions</div>
          <div style="font-size:10px;color:rgba(255,255,255,0.5);margin-top:4px">Refuted safe: ${esc(refutations)}</div>
        </div>
      </div>

      <div class="wlt-card">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px">
          <h4 style="margin:0;font-size:12px;font-family:var(--mono);color:var(--paper1)">OPEN BOOK HOLDINGS (${ob.total_open_count || 0} POSITIONS · $${(ob.total_value_usd || 0).toFixed(2)})</h4>
          <span style="font-family:var(--mono);font-size:10px;color:var(--amber)">24h Posture: ${esc(act.posture || 'Rotating')} ($${fmtK(act.buys_usd || 0)} buy / $${fmtK(act.sells_usd || 0)} sell)</span>
        </div>
        <div style="font-size:11px;color:rgba(255,255,255,0.6);margin-bottom:10px;font-family:var(--mono)">Recent Buys: ${recentBuys}</div>
        <table class="giga-openbook-table">
          <thead>
            <tr>
              <th>TOKEN</th>
              <th>VALUE (USD)</th>
              <th>COST BASIS</th>
              <th>SELL TXNS</th>
              <th>SECURITY</th>
            </tr>
          </thead>
          <tbody>
            ${obRows}
          </tbody>
        </table>
      </div>
    </div>`;
  }

  const v=d.verdict||{tone:'ok',text:''};
  const vText=(lang==='en'&&v.text_en)?v.text_en:v.text;
  html+=`<div class="wlt-verdict ${v.tone}"><span>${esc(vText)}</span><span class="badge">${W.learn}</span></div>`;

  document.getElementById('wltResult').innerHTML=html;
}

/* ══════════ MY WALLET EVALUATION ENGINE ══════════ */
let currentMyWalletAddr = '';
let myWalletOverrideAddr = '';

async function loadMyWalletData(){
  try {
    const url = myWalletOverrideAddr 
      ? (API + '/api/wallet/my?chain=' + curChain + '&address=' + encodeURIComponent(myWalletOverrideAddr))
      : (API + '/api/wallet/my?chain=' + curChain);
    const res = await fetch(url);
    if(!res.ok) return;
    const data = await res.json();
    renderMyWallet(data);
  } catch(e) {
    console.error('Failed to load my wallet data:', e);
  }
}

function copyCurrentMyWalletAddr(){
  if(!currentMyWalletAddr) return;
  copyToClipboard(currentMyWalletAddr);
  toast('COPIED WALLET ADDRESS', 'ok');
}

function applyCustomMyWalletAddr(){
  const inp = document.getElementById('mywCustomAddr');
  if(!inp) return;
  const val = inp.value.trim();
  if(!val) return;
  myWalletOverrideAddr = val;
  loadMyWalletData();
  toast('EVALUATING CUSTOM ADDRESS: ' + val.slice(0,6) + '...', 'ok');
}

function resetMyWalletToDefault(){
  myWalletOverrideAddr = '';
  const inp = document.getElementById('mywCustomAddr');
  if(inp) inp.value = '';
  loadMyWalletData();
  toast('RESET TO DEFAULT BOUND WALLET', 'ok');
}

function selectMyWalletProfile(chain, addr){
  curChain = chain;
  document.getElementById('chainPill').textContent = (CHAIN_LABEL[curChain] || chain).toUpperCase();
  myWalletOverrideAddr = addr;
  loadMyWalletData();
}

function apiSellToken(chain, addr, sym){
  if(!confirm('Execute market sell for ' + sym + ' (' + addr.slice(0,6) + '...)?')) return;
  fetch(API+'/api/sell',{
    method:'POST',
    headers:{'Content-Type':'application/json'},
    body: JSON.stringify({address: addr, chain: chain || curChain})
  })
  .then(async r=>{
    if(!r.ok) throw new Error('Sell failed');
    toast('SELL ORDER SENT: ' + sym, 'ok');
    setTimeout(loadMyWalletData, 1200);
  })
  .catch(e=>toast('SELL FAILED: ' + e.message, 'err'));
}

function renderMyWallet(data){
  if(!data) return;
  currentMyWalletAddr = data.address || '';
  const shortAddr = currentMyWalletAddr ? (currentMyWalletAddr.slice(0,6) + '...' + currentMyWalletAddr.slice(-4)) : '--';
  const cBadge = document.getElementById('mywChainActiveBadge');
  const shortPill = document.getElementById('mywCurrentAddrShort');
  if(shortPill) shortPill.textContent = shortAddr;
  if(cBadge) cBadge.textContent = 'ACTIVE: ' + (data.chain||'sol').toUpperCase() + ' (' + shortAddr + ')';

  // Multi-chain profiles
  const profilesBox = document.getElementById('mywProfilesGrid');
  if(profilesBox && data.bound_profiles){
    profilesBox.innerHTML = data.bound_profiles.map(p => {
      const isAct = p.chain === data.chain && (!myWalletOverrideAddr || myWalletOverrideAddr === p.address);
      return `
        <div class="myw-prof-card ${isAct ? 'active' : ''}" onclick="selectMyWalletProfile('${p.chain}', '${p.address}')">
          <div style="display:flex;justify-content:space-between;align-items:center">
            <span class="myw-prof-label">${esc(p.label)}</span>
            <span style="font-family:var(--mono);font-size:9px;color:${isAct?'var(--lime)':'rgba(255,255,255,0.4)'}">${p.native_symbol}</span>
          </div>
          <div class="myw-prof-addr">${p.address.slice(0,6)}...${p.address.slice(-4)}</div>
        </div>
      `;
    }).join('');
  }

  // Core Performance Quad
  const bs = data.bot_session || {};
  const st = data.stats || {};

  const realVal = document.getElementById('mywRealizedVal');
  const realSub = document.getElementById('mywRealizedSub');
  if(realVal) realVal.textContent = (bs.total_realized_pnl_sol >= 0 ? '+' : '') + (bs.total_realized_pnl_sol || 0).toFixed(4) + ' SOL';
  if(realSub) realSub.textContent = '≈ $' + (st.realized_profit || 0).toFixed(2) + ' USD (ROI ' + ((st.roi||0)*100).toFixed(2) + '%)';

  const wrVal = document.getElementById('mywWinRateVal');
  const wrSub = document.getElementById('mywWinRateSub');
  if(wrVal) wrVal.textContent = (bs.win_rate_pct || 0).toFixed(1) + '%';
  if(wrSub) wrSub.textContent = (bs.total_trades_opened || 0) + ' Buys / ' + (bs.total_trades_closed || 0) + ' Sells (' + ((bs.total_trades_opened||0) + (bs.total_trades_closed||0)) + ' Total)';

  const pfVal = document.getElementById('mywProfitFactorVal');
  const pfSub = document.getElementById('mywProfitFactorSub');
  if(pfVal) pfVal.textContent = (bs.profit_factor || 1.0).toFixed(2) + 'x';
  if(pfSub) pfSub.textContent = '+' + (bs.total_sol_gained || 0).toFixed(4) + ' SOL Gained / -' + (bs.total_sol_lost || 0).toFixed(4) + ' SOL Lost';

  const capVal = document.getElementById('mywCapitalVal');
  const capSub = document.getElementById('mywCapitalSub');
  if(capVal) capVal.textContent = (bs.active_slots || 0) + ' / ' + (bs.max_slots || 36) + ' Slots';
  if(capSub) capSub.textContent = 'Max Exposure: ' + (bs.max_exposure_sol || 3.60) + ' SOL (50% Reserve Safe)';

  // Giga Scorecard
  const gigaBox = document.getElementById('mywGigaContainer');
  if(gigaBox && data.giga){
    const g = data.giga;
    const fg = g.gates || [];
    const gatesHtml = fg.map(gate => {
      const isPass = gate.passed;
      return `
        <div class="giga-gate-card ${isPass ? 'passed' : 'failed'}">
          <div class="giga-gate-head">
            <span class="giga-gate-name">${esc(gate.name)}</span>
            <span class="giga-gate-status ${isPass ? 'pass' : 'fail'}">${gate.status.toUpperCase()}</span>
          </div>
          <div class="giga-gate-desc">${esc(gate.summary)}</div>
        </div>
      `;
    }).join('');

    const sty = g.style || {};
    const adv = g.advisory || {};

    gigaBox.innerHTML = `
      <div class="giga-wrap">
        <div class="giga-advisory-box" style="border-color:rgba(200,242,74,0.3);background:rgba(200,242,74,0.06)">
          <div class="giga-advisory-badge" style="background:var(--lime);color:#000">${esc(adv.badge || 'SELF_OPERATED')}</div>
          <div class="giga-advisory-text" style="color:var(--paper1)">
            <b>${esc(adv.action || 'Optimal Execution Node')}</b>: ${esc(adv.description || '')}
          </div>
        </div>

        <div class="wlt-card">
          <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px">
            <h4 style="margin:0;font-size:12px;font-family:var(--mono);color:var(--paper1);letter-spacing:0.05em">GIGA BETA 4-GATE AUDIT SCORECARD</h4>
            <span style="font-family:var(--mono);font-size:10px;color:var(--lime)">ZERO LOSS-CUTTING SLIPPAGE</span>
          </div>
          <div class="giga-gates-grid">${gatesHtml}</div>
        </div>

        <div class="giga-style-card">
          <div>
            <div style="font-size:10px;color:rgba(255,255,255,0.4);font-family:var(--mono)">EXECUTION STYLE &amp; SENTINELS</div>
            <div style="font-size:13px;font-weight:700;color:var(--lime);margin-top:2px">${esc(sty.label || 'Quantitative Momentum Sniper')}</div>
            <div style="font-size:11px;color:rgba(255,255,255,0.6);margin-top:4px">${esc(sty.speed || 'Autonomous Micro-Cadence')}</div>
          </div>
          <div>
            <div style="font-size:10px;color:rgba(255,255,255,0.4);font-family:var(--mono)">PROFIT HARVESTING MATRIX</div>
            <div style="font-size:12px;color:var(--paper2);margin-top:2px">Tier 1 (+10%), Tier 2 (+20%), Tier 3 (+40%), Moonbag (+70%)</div>
            <div style="font-size:11px;color:rgba(255,255,255,0.6);margin-top:4px">Break-even stop floor locked at +1.5%</div>
          </div>
          <div>
            <div style="font-size:10px;color:rgba(255,255,255,0.4);font-family:var(--mono)">RISK DEFENSE SENTINELS</div>
            <div style="font-size:12px;color:var(--lime);margin-top:2px">23 Supreme Sentinels Active</div>
            <div style="font-size:10px;color:rgba(255,255,255,0.5);margin-top:4px">Zero Rugs Missed · Hard 50% Exposure Cap</div>
          </div>
        </div>
      </div>
    `;
  }

  // Active Positions
  const posCount = document.getElementById('mywActiveSlotsCount');
  const posBody = document.getElementById('mywPositionsBody');
  const activePos = data.active_positions || [];
  if(posCount) posCount.textContent = activePos.length + ' POSITIONS ACTIVE';
  if(posBody){
    if(!activePos.length){
      posBody.innerHTML = '<tr><td colspan="7" style="text-align:center;color:var(--dim2);padding:18px">NO ACTIVE ROTATION POSITIONS</td></tr>';
    } else {
      posBody.innerHTML = activePos.map(p => {
        const pnl = p.pnl || 0;
        const pnlPct = (pnl * 100).toFixed(2);
        const pnlCol = pnl >= 0 ? 'var(--lime)' : 'var(--clay)';
        return `
          <tr>
            <td><b style="color:var(--paper1)">$${esc(p.symbol)}</b></td>
            <td style="color:rgba(255,255,255,0.5)">${(p.address||'').slice(0,6)}...${(p.address||'').slice(-4)}</td>
            <td>$${fmtPrice(p.entry_price || 0)}</td>
            <td>$${fmtPrice(p.cur_price || p.entry_price || 0)}</td>
            <td style="color:${pnlCol};font-weight:700">${pnl >= 0 ? '+' : ''}${pnlPct}%</td>
            <td style="color:var(--lime)">+1.5% Locked</td>
            <td>
              <button class="mbtn" style="padding:3px 8px;font-size:10px;border-color:var(--clay);color:var(--clay)" onclick="apiSellToken('${p.chain||curChain}', '${p.address}', '${esc(p.symbol)}')">EXIT SLOT</button>
            </td>
          </tr>
        `;
      }).join('');
    }
  }

  // Closed History
  const histBody = document.getElementById('mywHistoryBody');
  const closed = data.closed_trades || [];
  if(histBody){
    if(!closed.length){
      histBody.innerHTML = '<tr><td colspan="5" style="text-align:center;color:var(--dim2);padding:18px">NO RECENT CLOSED TRADES</td></tr>';
    } else {
      histBody.innerHTML = closed.map(c => {
        const pnlSol = c.pnl_sol || 0;
        const pnlCol = pnlSol >= 0 ? 'var(--lime)' : 'var(--clay)';
        return `
          <tr>
            <td><b style="color:var(--paper1)">$${esc(c.symbol)}</b></td>
            <td style="color:rgba(255,255,255,0.5)">${(c.address||'').slice(0,6)}...${(c.address||'').slice(-4)}</td>
            <td style="color:${pnlCol};font-weight:700">${pnlSol >= 0 ? '+' : ''}${pnlSol.toFixed(4)} SOL</td>
            <td style="color:${pnlCol}">${c.last_pnl_pct >= 0 ? '+' : ''}${c.last_pnl_pct.toFixed(2)}%</td>
            <td style="color:rgba(255,255,255,0.6)">PARTIAL_TP / RATCHET</td>
          </tr>
        `;
      }).join('');
    }
  }
}

/* ── init ── */
if(location.protocol==='file:'){
  const b=document.getElementById('fileProtocolBanner');
  if(b)b.style.display='block';
}
applyI18n();tick();
switchView(curView);
setInterval(tick,1000);
pollPositions();
scanCycle();
pollTimer=setInterval(scanCycle,pollMs);
setInterval(pollPositions,3000);
setInterval(telemetry,2600);
loadAnalyticsData();
loadHistoryViewData();
loadKolSignals();
setInterval(loadAnalyticsData,3000);
setInterval(loadKolSignals,8000);
// tab 重新可见时立即补一轮（轮询在隐藏时已自动暂停，见 scanCycle）
document.addEventListener('visibilitychange',()=>{if(!document.hidden&&source==='backend'&&bePolling){pollPositions();scanCycle();loadAnalyticsData();loadHistoryViewData();loadKolSignals();if(curView==='mywallet')loadMyWalletData();}});

/* 页面加载即探测后端：环境已有 key 就自动连真实数据，免去每次重填 */
async function autoConnect(){
  // 链是「每个 tab 独立」的视图偏好：本 tab 用 sessionStorage（互不干扰），
  // localStorage 只作「新 tab 的默认链」种子。
  const savedChain=sessionStorage.getItem('aitrader_chain')||localStorage.getItem('aitrader_chain')||'sol';
  curChain=savedChain;
  document.getElementById('chainPill').textContent=CHAIN_LABEL[curChain]||'SOL';
  buyAmount=loadBuyAmt(curChain);
  const ai=document.getElementById('amtInput');if(ai)ai.value=buyAmount;
  updateAmtUnit();
  try{
    const r=await fetch(API+'/api/status');
    const d=await r.json(); beReady=true; tradingLocked=!!d.trading_locked;
    setSource('backend');
  }catch(e){
    console.warn('Backend auto-connect probe:', e);
    setSource('backend');
  }
}
autoConnect();
</script>
</body>
</html>
